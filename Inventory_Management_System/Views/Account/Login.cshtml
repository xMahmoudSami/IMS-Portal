@model Inventory_Management_System.ViewModels.LoginViewModel
@using System.Globalization
@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture.Equals("ar", StringComparison.OrdinalIgnoreCase);

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var cultures = new[]
    {
        (Code: "en", Flag: "🇬🇧", Label: "English"),
        (Code: "ar", Flag: "🇸🇦", Label: "العربية"),
        (Code: "fr", Flag: "🇫🇷", Label: "Français"),
        (Code: "es", Flag: "🇪🇸", Label: "Español"),
        (Code: "it", Flag: "🇮🇹", Label: "Italiano"),
        (Code: "de", Flag: "🇩🇪", Label: "Deutsch")
    };

    var demoCardTitle = currentCulture switch
    {
        "ar" => "تعبئة بيانات تجريبية:",
        "fr" => "Remplissage auto démo :",
        "es" => "Autocompletar credenciales demo:",
        "it" => "Autocompilazione credenziali demo:",
        "de" => "Demo-Zugangsdaten automatisch ausfüllen:",
        _    => "Demo Credentials Autofill:"
    };

    var demoClickHint = currentCulture switch
    {
        "ar" => "انقر للتعبئة التلقائية",
        "fr" => "Cliquer pour remplir",
        "es" => "Haga clic para autocompletar",
        "it" => "Clicca per autocompilare",
        "de" => "Klicken zum Ausfüllen",
        _    => "Click to autofill"
    };

    var roleLabels = currentCulture switch
    {
        "ar" => new { Admin = "المشرف العام", Warehouse = "مدير المستودع", Cashier = "أمين الصندوق", Procurement = "مسؤول المشتريات", Auditor = "مدقق مالي" },
        "fr" => new { Admin = "Administrateur", Warehouse = "Gestionnaire d'entrepôt", Cashier = "Caissier", Procurement = "Responsable des achats", Auditor = "Auditeur" },
        "es" => new { Admin = "Administrador", Warehouse = "Gerente de almacén", Cashier = "Cajero", Procurement = "Especialista en compras", Auditor = "Auditor" },
        "it" => new { Admin = "Amministratore", Warehouse = "Responsabile del magazzino", Cashier = "Cassiere", Procurement = "Addetto agli acquisti", Auditor = "Revisore dei conti" },
        "de" => new { Admin = "Administrator", Warehouse = "Lagermanager", Cashier = "Kassierer", Procurement = "Beschaffungsspezialist", Auditor = "Prüfer" },
        _    => new { Admin = "Administrator", Warehouse = "Warehouse Manager", Cashier = "Cashier", Procurement = "Procurement Specialist", Auditor = "Auditor" }
    };
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@Loc["Lbl_LoginTitle"] - Inventory Management System</title>

    <!-- Synchronous anti-flicker theme detection -->
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('ims_theme');
                if (savedTheme !== 'light' && savedTheme !== 'dark') {
                    savedTheme = 'dark';
                }
                document.documentElement.setAttribute('data-theme', savedTheme);
                document.cookie = 'ims_theme=' + savedTheme + ';path=/;max-age=31536000;SameSite=Lax';
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>

    <!-- Custom fonts -->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Core Styles -->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    @if (isRtl)
    {
        <link href="~/css/rtl.css" rel="stylesheet" />
    }

    <style>
        .auth-container {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem 1rem;
            position: relative;
            background: radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.15) 0%, transparent 60%), var(--bg-base);
        }

        .auth-header-bar {
            position: absolute;
            top: 1.5rem;
            left: 2rem;
            right: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }

        .auth-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-heading);
            text-decoration: none;
            letter-spacing: -0.02em;
        }

        .auth-brand-icon {
            width: 42px;
            height: 42px;
            border-radius: var(--radius-md);
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            box-shadow: var(--primary-glow);
        }

        .auth-card {
            width: 100%;
            max-width: 460px;
            background: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-lg);
            padding: 2.5rem;
            position: relative;
            z-index: 5;
            backdrop-filter: blur(12px);
        }

        .auth-title {
            font-size: 1.65rem;
            font-weight: 800;
            color: var(--text-heading);
            margin-bottom: 0.35rem;
        }

        .auth-subtitle {
            color: var(--text-muted);
            font-size: 0.92rem;
            margin-bottom: 2rem;
        }

        .input-group-auth {
            position: relative;
            margin-bottom: 1.25rem;
            display: block;
            width: 100%;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 1.15rem;
            color: var(--text-subtle);
            font-size: 1rem;
            pointer-events: none;
            z-index: 4;
            transition: var(--transition-fast);
        }

        [dir="rtl"] .input-icon {
            left: auto;
            right: 1.15rem;
        }

        .input-group-auth .form-control-auth,
        input.form-control-auth,
        input[type="text"].form-control-auth,
        input[type="password"].form-control-auth,
        input[type="email"].form-control-auth {
            height: 50px !important;
            padding-left: 3.1rem !important;
            padding-right: 1.15rem !important;
            background: var(--bg-input) !important;
            border: 1px solid var(--border-default) !important;
            border-radius: var(--radius-md) !important;
            color: var(--text-heading) !important;
            font-size: 0.95rem !important;
            transition: var(--transition-base) !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        .input-group-auth:has(.password-toggle-btn) .form-control-auth,
        .input-group-auth .form-control-auth.has-toggle,
        input.form-control-auth.has-toggle {
            padding-right: 3rem !important;
        }

        [dir="rtl"] .input-group-auth .form-control-auth,
        [dir="rtl"] input.form-control-auth,
        [dir="rtl"] input[type="text"].form-control-auth,
        [dir="rtl"] input[type="password"].form-control-auth,
        [dir="rtl"] input[type="email"].form-control-auth {
            padding-left: 1.15rem !important;
            padding-right: 3.1rem !important;
        }

        [dir="rtl"] .input-group-auth:has(.password-toggle-btn) .form-control-auth,
        [dir="rtl"] .input-group-auth .form-control-auth.has-toggle,
        [dir="rtl"] input.form-control-auth.has-toggle {
            padding-left: 3rem !important;
            padding-right: 3.1rem !important;
        }

        .input-group-auth .form-control-auth:focus,
        input.form-control-auth:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px var(--primary-light) !important;
            background: var(--bg-surface-elevated) !important;
            outline: none !important;
        }

        .password-toggle-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            right: 1rem;
            background: none;
            border: none;
            color: var(--text-subtle);
            cursor: pointer;
            z-index: 5;
            padding: 0.25rem;
        }

        [dir="rtl"] .password-toggle-btn {
            right: auto;
            left: 1rem;
        }

        .btn-auth-primary {
            height: 50px;
            background: var(--primary-gradient);
            color: #ffffff;
            font-weight: 700;
            font-size: 1rem;
            border-radius: var(--radius-md);
            border: none;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: var(--transition-base);
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
            cursor: pointer;
        }

        .btn-auth-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--primary-glow);
            color: #ffffff;
        }

        .demo-roles-card {
            width: 100%;
            max-width: 460px;
            margin-top: 1.5rem;
            background: var(--bg-surface-elevated);
            border: 1px dashed var(--border-default);
            border-radius: var(--radius-md);
            padding: 1rem 1.25rem;
            font-size: 0.84rem;
        }

        .demo-pill {
            display: inline-block;
            padding: 0.2rem 0.5rem;
            border-radius: var(--radius-pill);
            font-size: 0.75rem;
            font-weight: 600;
            background: rgba(99, 102, 241, 0.15);
            color: var(--primary);
            cursor: pointer;
            margin: 0.15rem;
            border: 1px solid rgba(99, 102, 241, 0.25);
            transition: var(--transition-fast);
        }

        .demo-pill:hover {
            background: var(--primary);
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <!-- Top Utility Bar (Branding, Language & Theme Switchers) -->
        <header class="auth-header-bar">
            <a href="~/" class="auth-brand">
                <div class="auth-brand-icon">
                    <i class="fas fa-boxes"></i>
                </div>
                <span>IMS Enterprise</span>
            </a>

            <div class="d-flex align-items-center" style="gap: 0.75rem;">
                <!-- Language Selector -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center"
                            type="button"
                            id="loginLangDropdown"
                            data-toggle="dropdown"
                            data-display="static"
                            aria-haspopup="true"
                            aria-expanded="false"
                            style="border-color: var(--border-default); color: var(--text-main); background: var(--bg-surface); gap: 0.4rem; border-radius: var(--radius-sm); padding: 0.35rem 0.75rem;">
                        <i class="fas fa-globe"></i>
                        <span>@cultures.FirstOrDefault(c => c.Code.Equals(currentCulture, StringComparison.OrdinalIgnoreCase)).Label</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right shadow" style="background: var(--bg-surface); border: 1px solid var(--border-default); margin-top: 0.35rem;">
                        @foreach (var lang in cultures)
                        {
                            bool isSelected = currentCulture.Equals(lang.Code, StringComparison.OrdinalIgnoreCase);
                            <form method="post" asp-controller="Culture" asp-action="SetLanguage" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="culture" value="@lang.Code" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="dropdown-item @(isSelected ? "active" : "")" style="color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
                                    <span>@lang.Flag</span>
                                    <span>@lang.Label</span>
                                    @if (isSelected)
                                    {
                                        <i class="fas fa-check ml-auto" style="font-size: 0.75rem;"></i>
                                    }
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <!-- Theme Toggle Button -->
                <button type="button"
                        id="authThemeToggle"
                        class="btn btn-sm btn-outline-secondary"
                        style="border-color: var(--border-default); color: var(--text-main); background: var(--bg-surface); border-radius: var(--radius-sm); padding: 0.35rem 0.65rem;"
                        title="Toggle Light / Dark Mode">
                    <i class="fas fa-moon" id="authThemeIcon"></i>
                </button>
            </div>
        </header>

        <!-- Main Login Card -->
        <div class="auth-card">
            <div class="text-center mb-4">
                <h1 class="auth-title">@Loc["Lbl_WelcomeBack"]</h1>
                <p class="auth-subtitle">@Loc["Lbl_LoginSubtitle"]</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
            {
                <div class="alert alert-danger d-flex align-items-center" role="alert" style="border-radius: var(--radius-md); font-size: 0.88rem; gap: 0.6rem;">
                    <i class="fas fa-exclamation-circle fa-lg"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success d-flex align-items-center" role="alert" style="border-radius: var(--radius-md); font-size: 0.88rem; gap: 0.6rem;">
                    <i class="fas fa-check-circle fa-lg"></i>
                    <div>@TempData["SuccessMessage"]</div>
                </div>
            }

            @if (TempData["NewMasterRecoveryKey"] != null)
            {
                <div class="alert alert-warning border shadow-sm mb-3" role="alert" style="border-radius: var(--radius-md); background: rgba(246, 194, 62, 0.12); border-color: #f6c23e !important;">
                    <div class="d-flex align-items-center mb-1 text-warning font-weight-bold">
                        <i class="fas fa-key mr-2"></i> @Loc["Lbl_NewRecoveryKeyGeneratedTitle"]
                    </div>
                    <p class="small mb-2" style="color: var(--text-main);">@Loc["Lbl_NewRecoveryKeyGeneratedDesc"]</p>
                    <div class="d-flex align-items-center p-2 rounded justify-content-between" style="background: #1e1e2d; border: 1px solid rgba(255,255,255,0.1);">
                        <code id="loginRecoveryKeyCode" class="text-warning font-weight-bold" style="font-size: 1.05rem; letter-spacing: 1px; font-family: monospace;">@TempData["NewMasterRecoveryKey"]</code>
                        <button type="button" class="btn btn-sm btn-outline-warning ml-2" onclick="navigator.clipboard.writeText(document.getElementById('loginRecoveryKeyCode').innerText.trim()); this.innerText='Copied!';">
                            <i class="fas fa-copy mr-1"></i> @Loc["Lbl_CopyKey"]
                        </button>
                    </div>
                </div>
            }

            <form asp-action="Login" method="post" id="loginForm" autocomplete="on">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <!-- Username or Email -->
                <div class="form-group mb-3">
                    <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">@Loc["Username"] / @Loc["Email"]</label>
                    <div class="input-group-auth">
                        <i class="fas fa-user input-icon"></i>
                        <input asp-for="Username"
                               id="inputUsername"
                               class="form-control-auth"
                               placeholder="@Loc["EnterUsernameOrEmail"]"
                               required
                               autofocus />
                    </div>
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <!-- Password -->
                <div class="form-group mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">@Loc["Password"]</label>
                        <a asp-action="ForgotPassword" class="small" style="color: var(--primary); font-weight: 600; text-decoration: none;">@Loc["ForgotPassword"]@(isRtl ? "؟" : "?")</a>
                    </div>
                    <div class="input-group-auth">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="Password"
                               id="inputPassword"
                               type="password"
                               class="form-control-auth has-toggle"
                               placeholder="@Loc["EnterPassword"]"
                               required />
                        <button type="button" class="password-toggle-btn" id="btnTogglePassword" title="Show/Hide Password">
                            <i class="fas fa-eye" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Remember Me -->
                <div class="form-group d-flex align-items-center justify-content-between mb-4">
                    <div class="custom-control custom-checkbox">
                        <input asp-for="RememberMe" type="checkbox" class="custom-control-input" id="rememberMeCheck" />
                        <label class="custom-control-label" for="rememberMeCheck" style="color: var(--text-muted); font-size: 0.88rem; cursor: pointer;">
                            @Loc["RememberMe"]
                        </label>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-auth-primary" id="btnLoginSubmit">
                    <span>@Loc["SignIn"]</span>
                    <i class="fas @(isRtl ? "fa-arrow-left" : "fa-arrow-right")"></i>
                </button>
            </form>
        </div>

        <!-- Demonstration Pre-seeded Accounts Quick Autofill Card -->
        <div class="demo-roles-card">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span style="font-weight: 700; color: var(--text-heading);"><i class="fas fa-key text-warning mr-1"></i> @demoCardTitle</span>
                <span class="text-muted small">@demoClickHint</span>
            </div>
            <div class="d-flex flex-wrap">
                <span class="demo-pill" onclick="fillCredentials('admin', 'Admin@12345')">👑 @roleLabels.Admin</span>
                <span class="demo-pill" onclick="fillCredentials('warehouse', 'Warehouse@12345')">📦 @roleLabels.Warehouse</span>
                <span class="demo-pill" onclick="fillCredentials('cashier', 'Cashier@12345')">🛒 @roleLabels.Cashier</span>
                <span class="demo-pill" onclick="fillCredentials('purchaser', 'Purchaser@12345')">🚚 @roleLabels.Procurement</span>
                <span class="demo-pill" onclick="fillCredentials('auditor', 'Auditor@12345')">📊 @roleLabels.Auditor</span>
            </div>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        // Password visibility toggle
        document.getElementById('btnTogglePassword').addEventListener('click', function () {
            var pwd = document.getElementById('inputPassword');
            var icon = document.getElementById('togglePasswordIcon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                pwd.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        });

        // Theme toggle logic
        var themeBtn = document.getElementById('authThemeToggle');
        var themeIcon = document.getElementById('authThemeIcon');

        function syncThemeIcon(theme) {
            if (theme === 'light') {
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            } else {
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            }
        }

        var currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
        syncThemeIcon(currentTheme);

        themeBtn.addEventListener('click', function () {
            var active = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = (active === 'light') ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            try {
                localStorage.setItem('ims_theme', next);
                document.cookie = 'ims_theme=' + next + ';path=/;max-age=31536000;SameSite=Lax';
            } catch (err) { }
            syncThemeIcon(next);
        });

        window.addEventListener('storage', function (e) {
            if (e.key === 'ims_theme' && (e.newValue === 'light' || e.newValue === 'dark')) {
                document.documentElement.setAttribute('data-theme', e.newValue);
                syncThemeIcon(e.newValue);
            }
        });

        window.addEventListener('pageshow', function () {
            var t = localStorage.getItem('ims_theme');
            if (t === 'light' || t === 'dark') {
                document.documentElement.setAttribute('data-theme', t);
                syncThemeIcon(t);
            }
        });

        // Demo credential autofill helper
        function fillCredentials(username, password) {
            document.getElementById('inputUsername').value = username;
            document.getElementById('inputPassword').value = password;
        }
    </script>
</body>
</html>
