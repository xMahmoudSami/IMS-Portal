@model Inventory_Management_System.ViewModels.ForgotPasswordStep1ViewModel
@using System.Globalization
@{
    Layout = null;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture.Equals("ar", StringComparison.OrdinalIgnoreCase);

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var cultures = new[]
    {
        (Code: "en", Flag: "🇬🇧", Label: "English"),
        (Code: "ar", Flag: "🇸🇦", Label: "العربية"),
        (Code: "fr", Flag: "🇫🇷", Label: "Français"),
        (Code: "es", Flag: "🇪🇸", Label: "Español"),
        (Code: "it", Flag: "🇮🇹", Label: "Italiano"),
        (Code: "de", Flag: "🇩🇪", Label: "Deutsch")
    };

    var recoverySubtitle = currentCulture switch
    {
        "ar" => "إعادة تعيين كلمة المرور دون اتصال باستخدام مفتاح الاستعادة الرئيسي أو رمز التحقق المؤقت",
        "fr" => "Réinitialisez votre mot de passe hors ligne à l'aide de votre clé de récupération principale ou de l'OTP",
        "es" => "Restablezca su contraseña localmente usando su clave maestra de recuperación o código OTP",
        "de" => "Setzen Sie Ihr Passwort offline mit Ihrem Master-Wiederherstellungsschlüssel oder Notfall-OTP zurück",
        "it" => "Reimposta la tua password offline utilizzando la chiave principale di recupero o il codice OTP",
        _    => "Reset your password offline using your Master Recovery Key or emergency OTP"
    };
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@Loc["Lbl_ForgotPasswordTitle"] - Inventory Management System</title>

    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('ims_theme');
                if (savedTheme !== 'light' && savedTheme !== 'dark') {
                    savedTheme = 'dark';
                }
                document.documentElement.setAttribute('data-theme', savedTheme);
                document.cookie = 'ims_theme=' + savedTheme + ';path=/;max-age=31536000;SameSite=Lax';
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>

    <!-- Custom fonts -->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Core Styles -->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    @if (isRtl)
    {
        <link href="~/css/rtl.css" rel="stylesheet" />
    }

    <style>
        .auth-container {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 2rem 1rem;
            position: relative;
            background: radial-gradient(circle at 50% 20%, rgba(99, 102, 241, 0.15) 0%, transparent 60%), var(--bg-base);
        }

        .auth-header-bar {
            position: absolute;
            top: 1.5rem;
            left: 2rem;
            right: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }

        .auth-brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-heading);
            text-decoration: none;
        }

        .auth-brand-icon {
            width: 42px;
            height: 42px;
            border-radius: var(--radius-md);
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            box-shadow: var(--primary-glow);
        }

        .auth-card {
            width: 100%;
            max-width: 460px;
            background: var(--bg-surface);
            border: 1px solid var(--border-default);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-lg);
            padding: 2.5rem;
            position: relative;
            z-index: 5;
            backdrop-filter: blur(12px);
        }

        .auth-title {
            font-size: 1.55rem;
            font-weight: 800;
            color: var(--text-heading);
            margin-bottom: 0.35rem;
        }

        .auth-subtitle {
            color: var(--text-muted);
            font-size: 0.92rem;
            margin-bottom: 2rem;
            line-height: 1.5;
        }

        .input-group-auth {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .input-icon {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            left: 1.1rem;
            color: var(--text-subtle);
            font-size: 1rem;
            pointer-events: none;
            z-index: 4;
        }

        [dir="rtl"] .input-icon {
            left: auto;
            right: 1.1rem;
        }

        .input-group-auth .form-control-auth,
        input.form-control-auth,
        input[type="text"].form-control-auth,
        input[type="password"].form-control-auth,
        input[type="email"].form-control-auth {
            height: 50px !important;
            padding-left: 3.1rem !important;
            padding-right: 1.15rem !important;
            background: var(--bg-input) !important;
            border: 1px solid var(--border-default) !important;
            border-radius: var(--radius-md) !important;
            color: var(--text-heading) !important;
            font-size: 0.95rem !important;
            width: 100% !important;
            box-sizing: border-box !important;
            transition: var(--transition-base) !important;
        }

        [dir="rtl"] .input-group-auth .form-control-auth,
        [dir="rtl"] input.form-control-auth,
        [dir="rtl"] input[type="text"].form-control-auth,
        [dir="rtl"] input[type="password"].form-control-auth,
        [dir="rtl"] input[type="email"].form-control-auth {
            padding-left: 1.15rem !important;
            padding-right: 3.1rem !important;
        }

        .input-group-auth .form-control-auth:focus,
        input.form-control-auth:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 3px var(--primary-light) !important;
            background: var(--bg-surface-elevated) !important;
            outline: none !important;
        }

        .btn-auth-primary {
            height: 50px;
            background: var(--primary-gradient);
            color: #ffffff;
            font-weight: 700;
            font-size: 1rem;
            border-radius: var(--radius-md);
            border: none;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.35);
            cursor: pointer;
            transition: var(--transition-base);
        }

        .btn-auth-primary:hover {
            transform: translateY(-2px);
            box-shadow: var(--primary-glow);
            color: #ffffff;
        }

        .recovery-info-box {
            background: rgba(99, 102, 241, 0.08);
            border: 1px solid rgba(99, 102, 241, 0.2);
            border-radius: var(--radius-md);
            padding: 0.85rem 1rem;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <!-- Top Header Bar -->
        <header class="auth-header-bar">
            <a href="~/" class="auth-brand">
                <div class="auth-brand-icon">
                    <i class="fas fa-boxes"></i>
                </div>
                <span>IMS Enterprise</span>
            </a>

            <div class="d-flex align-items-center" style="gap: 0.75rem;">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center"
                            type="button"
                            id="langDropdown"
                            data-toggle="dropdown"
                            data-display="static"
                            aria-haspopup="true"
                            aria-expanded="false"
                            style="border-color: var(--border-default); color: var(--text-main); background: var(--bg-surface); gap: 0.4rem; border-radius: var(--radius-sm); padding: 0.35rem 0.75rem;">
                        <i class="fas fa-globe"></i>
                        <span>@cultures.FirstOrDefault(c => c.Code.Equals(currentCulture, StringComparison.OrdinalIgnoreCase)).Label</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right shadow" style="background: var(--bg-surface); border: 1px solid var(--border-default); margin-top: 0.35rem;">
                        @foreach (var lang in cultures)
                        {
                            bool isSelected = currentCulture.Equals(lang.Code, StringComparison.OrdinalIgnoreCase);
                            <form method="post" asp-controller="Culture" asp-action="SetLanguage" style="margin: 0;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="culture" value="@lang.Code" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="dropdown-item @(isSelected ? "active" : "")" style="color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
                                    <span>@lang.Flag</span>
                                    <span>@lang.Label</span>
                                </button>
                            </form>
                        }
                    </div>
                </div>

                <button type="button"
                        id="authThemeToggle"
                        class="btn btn-sm btn-outline-secondary"
                        style="border-color: var(--border-default); color: var(--text-main); background: var(--bg-surface); border-radius: var(--radius-sm); padding: 0.35rem 0.65rem;">
                    <i class="fas fa-moon" id="authThemeIcon"></i>
                </button>
            </div>
        </header>

        <!-- Forgot Password Card -->
        <div class="auth-card">
            <div class="text-center mb-4">
                <div class="auth-brand-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.25rem;">
                    <i class="fas fa-shield-alt"></i>
                </div>
                <h1 class="auth-title">@Loc["Lbl_SelfServiceRecovery"]</h1>
                <p class="auth-subtitle">@recoverySubtitle</p>
            </div>

            <div class="recovery-info-box">
                <i class="fas fa-info-circle text-primary mt-1"></i>
                <div>
                    <strong>@Loc["Lbl_ZeroSmtpNoteTitle"]:</strong> @Loc["Lbl_ZeroSmtpNoteDesc"]
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty] != null)
            {
                <div class="alert alert-danger d-flex align-items-center mb-3" role="alert" style="border-radius: var(--radius-md); font-size: 0.88rem; gap: 0.6rem;">
                    <i class="fas fa-exclamation-circle fa-lg"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group mb-4">
                    <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">@Loc["Username"] / @Loc["Email"]</label>
                    <div class="input-group-auth">
                        <i class="fas fa-user-tag input-icon"></i>
                        <input asp-for="UsernameOrEmail"
                               class="form-control-auth"
                               placeholder="@Loc["EnterUsernameOrEmail"]"
                               required
                               autofocus />
                    </div>
                    <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn-auth-primary mb-3">
                    <span>@Loc["Lbl_VerifyAccount"]</span>
                    <i class="fas @(isRtl ? "fa-arrow-left" : "fa-arrow-right")"></i>
                </button>

                <div class="text-center">
                    <a asp-action="Login" style="color: var(--text-muted); font-size: 0.88rem; text-decoration: none;">
                        <i class="fas @(isRtl ? "fa-arrow-right ml-1" : "fa-arrow-left mr-1")"></i> @Loc["Lbl_BackToLogin"]
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Core Scripts -->
    <script src="~/vendor/jquery/jquery.min.js"></script>
    <script src="~/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        var themeBtn = document.getElementById('authThemeToggle');
        var themeIcon = document.getElementById('authThemeIcon');

        function syncThemeIcon(theme) {
            if (theme === 'light') {
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            } else {
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            }
        }

        var currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
        syncThemeIcon(currentTheme);

        themeBtn.addEventListener('click', function () {
            var active = document.documentElement.getAttribute('data-theme') || 'dark';
            var next = (active === 'light') ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', next);
            try {
                localStorage.setItem('ims_theme', next);
                document.cookie = 'ims_theme=' + next + ';path=/;max-age=31536000;SameSite=Lax';
            } catch (err) { }
            syncThemeIcon(next);
        });

        window.addEventListener('storage', function (e) {
            if (e.key === 'ims_theme' && (e.newValue === 'light' || e.newValue === 'dark')) {
                document.documentElement.setAttribute('data-theme', e.newValue);
                syncThemeIcon(e.newValue);
            }
        });

        window.addEventListener('pageshow', function () {
            var t = localStorage.getItem('ims_theme');
            if (t === 'light' || t === 'dark') {
                document.documentElement.setAttribute('data-theme', t);
                syncThemeIcon(t);
            }
        });
    </script>
</body>
</html>
