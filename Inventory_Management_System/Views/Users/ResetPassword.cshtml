@model Inventory_Management_System.ViewModels.AdminResetPasswordViewModel
@using System.Globalization
@{
    ViewData["Title"] = Loc["Lbl_DirectPasswordReset"].Value;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture.Equals("ar", StringComparison.OrdinalIgnoreCase);

    var setNewPasswordLabel = (!Loc["Lbl_SetNewPassword"].IsResourceNotFound && Loc["Lbl_SetNewPassword"].Value != "Lbl_SetNewPassword")
        ? Loc["Lbl_SetNewPassword"].Value
        : (currentCulture switch
        {
            "ar" => "تعيين كلمة المرور الجديدة",
            "fr" => "Définir le nouveau mot de passe",
            "es" => "Establecer nueva contraseña",
            "de" => "Neues Passwort festlegen",
            "it" => "Imposta nuova password",
            _    => "Set New Password"
        });

    var targetUserLabel = (!Loc["Lbl_TargetUser"].IsResourceNotFound && Loc["Lbl_TargetUser"].Value != "Lbl_TargetUser")
        ? Loc["Lbl_TargetUser"].Value.TrimEnd(':', ' ', '：')
        : (currentCulture switch
        {
            "ar" => "المستخدم المستهدف",
            "fr" => "Utilisateur cible",
            "es" => "Usuario objetivo",
            "de" => "Zielbenutzer",
            "it" => "Utente di destinazione",
            _    => "Target User"
        });

    var min8CharsPlaceholder = (!Loc["Placeholder_Min8Chars"].IsResourceNotFound && Loc["Placeholder_Min8Chars"].Value != "Placeholder_Min8Chars")
        ? Loc["Placeholder_Min8Chars"].Value
        : (currentCulture switch
        {
            "ar" => "8 أحرف على الأقل",
            "fr" => "Minimum 8 caractères",
            "es" => "Mínimo 8 caracteres",
            "de" => "Mindestens 8 Zeichen",
            "it" => "Minimo 8 caratteri",
            _    => "Minimum 8 characters"
        });

    var reenterNewPasswordPlaceholder = (!Loc["Placeholder_ReenterNewPassword"].IsResourceNotFound && Loc["Placeholder_ReenterNewPassword"].Value != "Placeholder_ReenterNewPassword")
        ? Loc["Placeholder_ReenterNewPassword"].Value
        : (currentCulture switch
        {
            "ar" => "أعد إدخال كلمة المرور الجديدة",
            "fr" => "Ressaisissez le nouveau mot de passe",
            "es" => "Vuelva a introducir la nueva contraseña",
            "de" => "Neues Passwort erneut eingeben",
            "it" => "Reinserisci la nuova password",
            _    => "Re-enter new password"
        });
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0" style="font-weight: 800; color: var(--text-heading);">
            <i class="fas fa-key text-warning mr-2"></i>@Loc["Lbl_DirectPasswordReset"]
        </h1>
        <p class="text-muted small mb-0 mt-1">@Loc["Lbl_DirectPasswordResetSubtitle"]</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: var(--radius-md);">
        <i class="fas @(isRtl ? "fa-arrow-right" : "fa-arrow-left") mr-1"></i> @Loc["Lbl_BackToUsersList"]
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-6 col-lg-8">
        <div class="card shadow-sm border-0 mb-4" style="background: var(--bg-surface); border-radius: var(--radius-lg); border: 1px solid var(--border-default) !important;">
            <div class="card-header py-3" style="background: var(--bg-surface-elevated); border-bottom: 1px solid var(--border-default);">
                <h6 class="m-0 font-weight-bold d-flex align-items-center flex-wrap" style="color: var(--text-heading); gap: 0.4rem;">
                    <i class="fas fa-user-shield text-warning mr-2"></i>
                    <span>@targetUserLabel:</span>
                    <strong class="text-white">@Model.FullName</strong>
                    <span class="text-muted small" dir="ltr" style="unicode-bidi: isolate;">(&#64;@Model.Username)</span>
                </h6>
            </div>

            <div class="card-body p-4">
                <div class="alert alert-info d-flex align-items-center mb-4" style="border-radius: var(--radius-md); font-size: 0.88rem; gap: 0.6rem;">
                    <i class="fas fa-info-circle fa-lg"></i>
                    <div>
                        @Loc["Lbl_AdminPasswordResetNotice"]
                    </div>
                </div>

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-4" role="alert" style="border-radius: var(--radius-md);">
                            <div class="font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-1"></i> @Loc["Lbl_PleaseCorrectErrors"]:</div>
                            <ul class="mb-0 pl-3">
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    foreach (var error in modelState.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <div class="form-group mb-3">
                        <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">
                            @Loc["Lbl_NewPassword"] <span class="text-danger">*</span>
                        </label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="@min8CharsPlaceholder" autofocus style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);" />
                        <span asp-validation-for="NewPassword" class="text-danger small font-weight-bold mt-1 d-block"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">
                            @Loc["Lbl_ConfirmNewPassword"] <span class="text-danger">*</span>
                        </label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="@reenterNewPasswordPlaceholder" style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small font-weight-bold mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-end" style="gap: 1rem;">
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2" style="border-radius: var(--radius-md);">
                            @Loc["Cancel"]
                        </a>
                        <button type="submit" class="btn btn-warning px-4 py-2 font-weight-bold" style="border-radius: var(--radius-md); color: #000;">
                            <i class="fas fa-key mr-2"></i> @setNewPasswordLabel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
