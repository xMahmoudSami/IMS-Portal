@model IEnumerable<Inventory_Management_System.ViewModels.UserListItemViewModel>
@using System.Globalization
@{
    ViewData["Title"] = Loc["Nav_UserManagement"].Value;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var roles = ViewBag.Roles as IReadOnlyList<string> ?? AppRoles.AllRoles;
    var currentRole = ViewBag.CurrentRole as string;
    var currentSearch = ViewBag.CurrentSearch as string;

    string FormatRole(string r)
    {
        var key = "Role_" + r;
        var localized = Loc[key];
        if (!localized.IsResourceNotFound && !string.IsNullOrWhiteSpace(localized.Value) && localized.Value != key)
        {
            return localized.Value;
        }

        return currentCulture switch
        {
            "ar" => r switch
            {
                AppRoles.SuperAdmin => "المشرف العام",
                AppRoles.WarehouseManager => "مدير المستودع",
                AppRoles.Cashier => "أمين الصندوق",
                AppRoles.ProcurementSpecialist => "مسؤول المشتريات",
                AppRoles.Auditor => "مدقق مالي",
                _ => r
            },
            "fr" => r switch
            {
                AppRoles.SuperAdmin => "Administrateur",
                AppRoles.WarehouseManager => "Gestionnaire d'entrepôt",
                AppRoles.Cashier => "Caissier",
                AppRoles.ProcurementSpecialist => "Responsable des achats",
                AppRoles.Auditor => "Auditeur",
                _ => r
            },
            "es" => r switch
            {
                AppRoles.SuperAdmin => "Administrador",
                AppRoles.WarehouseManager => "Gerente de almacén",
                AppRoles.Cashier => "Cajero",
                AppRoles.ProcurementSpecialist => "Especialista en compras",
                AppRoles.Auditor => "Auditor",
                _ => r
            },
            "de" => r switch
            {
                AppRoles.SuperAdmin => "Administrator",
                AppRoles.WarehouseManager => "Lagermanager",
                AppRoles.Cashier => "Kassierer",
                AppRoles.ProcurementSpecialist => "Beschaffungsspezialist",
                AppRoles.Auditor => "Prüfer",
                _ => r
            },
            "it" => r switch
            {
                AppRoles.SuperAdmin => "Amministratore",
                AppRoles.WarehouseManager => "Responsabile del magazzino",
                AppRoles.Cashier => "Cassiere",
                AppRoles.ProcurementSpecialist => "Addetto agli acquisti",
                AppRoles.Auditor => "Revisore dei conti",
                _ => r
            },
            _ => r switch
            {
                AppRoles.SuperAdmin => "Administrator",
                AppRoles.WarehouseManager => "Warehouse Manager",
                AppRoles.Cashier => "Cashier",
                AppRoles.ProcurementSpecialist => "Procurement Specialist",
                AppRoles.Auditor => "Auditor",
                _ => r
            }
        };
    }

    var neverLabel = (!Loc["Lbl_Never"].IsResourceNotFound && Loc["Lbl_Never"].Value != "Lbl_Never")
        ? Loc["Lbl_Never"].Value
        : (currentCulture switch
        {
            "ar" => "لم يسجل دخول بعد",
            "fr" => "Jamais",
            "es" => "Nunca",
            "de" => "Nie",
            "it" => "Mai",
            _ => "Never"
        });

    var masterRecoveryKeyTitle = (!Loc["Lbl_MasterRecoveryKeyTitle"].IsResourceNotFound && Loc["Lbl_MasterRecoveryKeyTitle"].Value != "Lbl_MasterRecoveryKeyTitle")
        ? Loc["Lbl_MasterRecoveryKeyTitle"].Value
        : (currentCulture switch { "ar" => "مفتاح الاستعادة الرئيسي", _ => "Master Recovery Key" });

    var newRecoveryKeyNotice = (!Loc["Lbl_NewRecoveryKeyNotice"].IsResourceNotFound && Loc["Lbl_NewRecoveryKeyNotice"].Value != "Lbl_NewRecoveryKeyNotice")
        ? Loc["Lbl_NewRecoveryKeyNotice"].Value
        : (currentCulture switch { "ar" => "تم إنشاء مفتاح استعادة رئيسي سري لهذا المستخدم. انسخه وقم بتسليمه للمستخدم بشكل آمن، فلن يظهر مجدداً.", _ => "A confidential Master Recovery Key has been generated for this user. Copy and provide it securely to the user. It will not be shown again." });

    var copyKeyLabel = (!Loc["Lbl_CopyKey"].IsResourceNotFound && Loc["Lbl_CopyKey"].Value != "Lbl_CopyKey")
        ? Loc["Lbl_CopyKey"].Value
        : (currentCulture switch { "ar" => "نسخ المفتاح", _ => "Copy Key" });

    var searchUsersPlaceholder = (!Loc["Lbl_SearchUsersPlaceholder"].IsResourceNotFound && Loc["Lbl_SearchUsersPlaceholder"].Value != "Lbl_SearchUsersPlaceholder")
        ? Loc["Lbl_SearchUsersPlaceholder"].Value
        : (currentCulture switch
        {
            "ar" => "البحث بالاسم أو اسم المستخدم أو البريد الإلكتروني...",
            "fr" => "Rechercher par nom, nom d'utilisateur ou e-mail...",
            "es" => "Buscar por nombre, usuario o correo electrónico...",
            "de" => "Nach Name, Benutzername oder E-Mail suchen...",
            "it" => "Cerca per nome, nome utente o e-mail...",
            _    => "Search by name, username, or email..."
        });

    var administratorOnlyLabel = (!Loc["Lbl_AdministratorOnly"].IsResourceNotFound && Loc["Lbl_AdministratorOnly"].Value != "Lbl_AdministratorOnly")
        ? Loc["Lbl_AdministratorOnly"].Value
        : (currentCulture switch
        {
            "ar" => "خاص بالمشرف العام",
            "fr" => "Administrateur uniquement",
            "es" => "Solo Administrador",
            "de" => "Nur Administrator",
            "it" => "Solo Amministratore",
            _    => "Administrator Only"
        });
}

<!-- Page Heading & Actions -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0" style="font-weight: 800; color: var(--text-heading);">
            <i class="fas fa-users-cog text-primary mr-2"></i>@Loc["Nav_UserManagement"]
        </h1>
        <p class="text-muted small mb-0 mt-1">@Loc["Lbl_UserManagementSubtitle"]</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm" style="border-radius: var(--radius-md); font-weight: 700;">
        <i class="fas fa-user-plus fa-sm text-white-50 mr-2"></i>@Loc["Lbl_CreateNewUser"]
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-4" role="alert" style="border-radius: var(--radius-md);">
        <i class="fas fa-check-circle fa-lg mr-2"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert" style="border-radius: var(--radius-md);">
        <i class="fas fa-exclamation-triangle fa-lg mr-2"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

@if (TempData["NewUserRecoveryKey"] != null)
{
    var newKey = TempData["NewUserRecoveryKey"]?.ToString() ?? "";
    var newName = TempData["NewUserName"]?.ToString() ?? "";
    <div class="card mb-4 border-left-warning shadow-sm" style="background: var(--bg-surface); border: 1px solid rgba(245, 158, 11, 0.4); border-left: 5px solid #f59e0b !important; border-radius: var(--radius-lg);">
        <div class="card-body p-4">
            <div class="d-flex align-items-start" style="gap: 1rem;">
                <div style="width: 44px; height: 44px; border-radius: 50%; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #f59e0b;">
                    <i class="fas fa-key fa-lg"></i>
                </div>
                <div class="flex-grow-1">
                    <h5 class="font-weight-bold mb-1" style="color: var(--text-heading);">
                        @masterRecoveryKeyTitle (@newName)
                    </h5>
                    <p class="small text-muted mb-3">
                        @newRecoveryKeyNotice
                    </p>
                    <div class="d-flex align-items-center flex-wrap" style="gap: 0.75rem;">
                        <code id="newGeneratedKey" class="p-2 px-3" style="font-size: 1.15rem; font-weight: 800; background: var(--bg-surface-elevated); color: #f59e0b; border: 1px dashed rgba(245, 158, 11, 0.4); border-radius: var(--radius-md); letter-spacing: 1.5px;">@newKey</code>
                        <button type="button" class="btn btn-sm btn-outline-warning" id="btnCopyNewUserKey" onclick="navigator.clipboard.writeText('@newKey'); this.innerText='Copied!'; setTimeout(() => this.innerText='@copyKeyLabel', 2000);" style="border-radius: var(--radius-sm); font-weight: 600;">
                            <i class="fas fa-copy mr-1"></i> @copyKeyLabel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Filter Bar -->
<div class="card shadow-sm border-0 mb-4" style="background: var(--bg-surface); border-radius: var(--radius-lg); border: 1px solid var(--border-default) !important;">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="form-row align-items-center">
            <div class="col-md-5 my-1">
                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text" style="background: var(--bg-surface-elevated); border-color: var(--border-default); color: var(--text-subtle);">
                            <i class="fas fa-search"></i>
                        </span>
                    </div>
                    <input type="text"
                           name="search"
                           value="@currentSearch"
                           class="form-control"
                           placeholder="@searchUsersPlaceholder"
                           style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);" />
                </div>
            </div>

            <div class="col-md-4 my-1">
                <select name="role" class="form-control" style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);">
                    <option value="">@Loc["Lbl_AllRoles"]</option>
                    @foreach (var r in roles)
                    {
                        <!option value="@r" @(string.Equals(currentRole, r, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>
                            @FormatRole(r)
                        </!option>
                    }
                </select>
            </div>

            <div class="col-md-3 my-1 d-flex" style="gap: 0.5rem;">
                <button type="submit" class="btn btn-primary flex-fill font-weight-bold" style="border-radius: var(--radius-sm);">
                    <i class="fas fa-filter mr-1"></i> @Loc["Filter"]
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentRole))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: var(--radius-sm);" title="@Loc["ClearFilter"]">
                        <i class="fas fa-times"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Users Table Card -->
<div class="card shadow-sm border-0 mb-4" style="background: var(--bg-surface); border-radius: var(--radius-lg); border: 1px solid var(--border-default) !important;">
    <div class="card-header py-3 d-flex justify-content-between align-items-center" style="background: var(--bg-surface-elevated); border-bottom: 1px solid var(--border-default);">
        <h6 class="m-0 font-weight-bold" style="color: var(--text-heading);">
            <i class="fas fa-list text-primary mr-2"></i>@Loc["Lbl_UsersList"] (@Model.Count())
        </h6>
        <span class="badge badge-secondary small font-weight-bold px-2 py-1" style="border-radius: var(--radius-sm); letter-spacing: 0.04em;">@administratorOnlyLabel</span>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="color: var(--text-main);">
                <thead style="background: var(--bg-surface-elevated); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-subtle);">
                    <tr>
                        <th style="padding: 1rem 1.25rem;">@Loc["Lbl_User"]</th>
                        <th>@Loc["Email"]</th>
                        <th>@Loc["Lbl_Role"]</th>
                        <th>@Loc["Status"]</th>
                        <th>@Loc["LastLogin"]</th>
                        <th class="text-right" style="padding-right: 1.25rem;">@Loc["Actions"]</th>
                    </tr>
                </thead>
                <tbody style="font-size: 0.9rem;">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-user-slash fa-3x mb-3 text-secondary"></i>
                                <div>@Loc["Lbl_NoUsersFound"]</div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            var roleBadgeClass = user.Role switch
                            {
                                AppRoles.SuperAdmin => "badge-danger",
                                AppRoles.WarehouseManager => "badge-primary",
                                AppRoles.Cashier => "badge-success",
                                AppRoles.ProcurementSpecialist => "badge-info",
                                AppRoles.Auditor => "badge-warning",
                                _ => "badge-secondary"
                            };

                            <tr style="border-bottom: 1px solid var(--border-subtle);">
                                <td style="padding: 0.85rem 1.25rem;">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm mr-3"
                                             style="width: 38px; height: 38px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.95rem; flex-shrink: 0;">
                                            @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div style="font-weight: 700; color: var(--text-heading);">
                                                @user.FullName
                                                @if (user.IsCurrentLoggedInUser)
                                                {
                                                    <span class="badge badge-pill badge-light border ml-1" style="font-size: 0.72rem;">@Loc["Lbl_You"]</span>
                                                }
                                            </div>
                                            <div class="small text-muted"><span dir="ltr" style="unicode-bidi: isolate;">@@@user.Username</span></div>
                                        </div>
                                    </div>
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge @roleBadgeClass px-2 py-1 font-weight-bold" style="font-size: 0.82rem;">
                                        @FormatRole(user.Role)
                                    </span>
                                </td>
                                <td>
                                    @if (user.IsLockedOut)
                                    {
                                        <span class="badge badge-danger px-2 py-1"><i class="fas fa-lock mr-1"></i> @Loc["Lbl_LockedOut"]</span>
                                    }
                                    else if (user.IsActive)
                                    {
                                        <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i> @Loc["Active"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary px-2 py-1"><i class="fas fa-ban mr-1"></i> @Loc["Lbl_Deactivated"]</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToString("yyyy-MM-dd HH:mm") : neverLabel)
                                </td>
                                <td class="text-right" style="padding-right: 1.25rem;">
                                    <div class="d-inline-flex" style="gap: 0.35rem;" role="group">
                                        <!-- Edit -->
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary" title="@Loc["Edit"]" style="border-radius: var(--radius-sm);">
                                            <i class="fas fa-pencil-alt"></i>
                                        </a>

                                        <!-- Direct Admin Password Reset -->
                                        <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning" title="@Loc["Lbl_DirectPasswordReset"]" style="border: 1px solid var(--warning) !important; color: #fbbf24; border-radius: var(--radius-sm);">
                                            <i class="fas fa-key"></i>
                                        </a>

                                        <!-- Toggle Status -->
                                        @if (!user.IsCurrentLoggedInUser)
                                        {
                                            <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" style="display: inline;"
                                                  data-confirm-message="@(user.IsActive ? Loc["Lbl_ConfirmDeactivateUser"] : Loc["Lbl_ConfirmActivateUser"])"
                                                  data-confirm-title="@(user.IsActive ? Loc["Lbl_Deactivate"] : Loc["Lbl_Activate"])"
                                                  data-confirm-type="@(user.IsActive ? "warning" : "info")"
                                                  data-confirm-destructive="@(user.IsActive ? "true" : "false")">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-secondary" : "btn-outline-success")" title="@(user.IsActive ? Loc["Lbl_Deactivate"] : Loc["Lbl_Activate"])" style="border-radius: var(--radius-sm);">
                                                    <i class="fas @(user.IsActive ? "fa-user-slash" : "fa-user-check")"></i>
                                                </button>
                                            </form>

                                            <!-- Delete -->
                                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display: inline;"
                                                  data-confirm-message="@Loc["Lbl_ConfirmDeleteUser"]"
                                                  data-confirm-title="@Loc["Delete"]"
                                                  data-confirm-type="danger"
                                                  data-confirm-destructive="true">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="@Loc["Delete"]" style="border-radius: var(--radius-sm);">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
