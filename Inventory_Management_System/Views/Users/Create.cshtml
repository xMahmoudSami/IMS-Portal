@model Inventory_Management_System.ViewModels.CreateUserViewModel
@using System.Globalization
@{
    ViewData["Title"] = Loc["Lbl_CreateNewUser"].Value;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture.Equals("ar", StringComparison.OrdinalIgnoreCase);
    var roles = ViewBag.Roles as IReadOnlyList<string> ?? AppRoles.AllRoles;

    string FormatRole(string r) => currentCulture switch
    {
        "ar" => r switch
        {
            AppRoles.SuperAdmin => "المشرف العام",
            AppRoles.WarehouseManager => "مدير المستودع",
            AppRoles.Cashier => "أمين الصندوق",
            AppRoles.ProcurementSpecialist => "مسؤول المشتريات",
            AppRoles.Auditor => "مدقق مالي",
            _ => r
        },
        "fr" => r switch
        {
            AppRoles.SuperAdmin => "Administrateur",
            AppRoles.WarehouseManager => "Gestionnaire d'entrepôt",
            AppRoles.Cashier => "Caissier",
            AppRoles.ProcurementSpecialist => "Responsable des achats",
            AppRoles.Auditor => "Auditeur",
            _ => r
        },
        "es" => r switch
        {
            AppRoles.SuperAdmin => "Administrador",
            AppRoles.WarehouseManager => "Gerente de almacén",
            AppRoles.Cashier => "Cajero",
            AppRoles.ProcurementSpecialist => "Especialista en compras",
            AppRoles.Auditor => "Auditor",
            _ => r
        },
        "de" => r switch
        {
            AppRoles.SuperAdmin => "Administrator",
            AppRoles.WarehouseManager => "Lagermanager",
            AppRoles.Cashier => "Kassierer",
            AppRoles.ProcurementSpecialist => "Beschaffungsspezialist",
            AppRoles.Auditor => "Prüfer",
            _ => r
        },
        "it" => r switch
        {
            AppRoles.SuperAdmin => "Amministratore",
            AppRoles.WarehouseManager => "Responsabile del magazzino",
            AppRoles.Cashier => "Cassiere",
            AppRoles.ProcurementSpecialist => "Addetto agli acquisti",
            AppRoles.Auditor => "Revisore dei conti",
            _ => r
        },
        _ => r switch
        {
            AppRoles.SuperAdmin => "Administrator",
            AppRoles.WarehouseManager => "Warehouse Manager",
            AppRoles.Cashier => "Cashier",
            AppRoles.ProcurementSpecialist => "Procurement Specialist",
            AppRoles.Auditor => "Auditor",
            _ => r
        }
    };

    var min8CharsPlaceholder = (!Loc["Placeholder_Min8Chars"].IsResourceNotFound && Loc["Placeholder_Min8Chars"].Value != "Placeholder_Min8Chars")
        ? Loc["Placeholder_Min8Chars"].Value
        : (currentCulture switch
        {
            "ar" => "8 أحرف على الأقل",
            "fr" => "Minimum 8 caractères",
            "es" => "Mínimo 8 caracteres",
            "de" => "Mindestens 8 Zeichen",
            "it" => "Minimo 8 caratteri",
            _    => "Minimum 8 characters"
        });

    var reenterPasswordPlaceholder = (!Loc["Placeholder_ReenterPassword"].IsResourceNotFound && Loc["Placeholder_ReenterPassword"].Value != "Placeholder_ReenterPassword")
        ? Loc["Placeholder_ReenterPassword"].Value
        : (currentCulture switch
        {
            "ar" => "أعد إدخال كلمة المرور",
            "fr" => "Ressaisissez le mot de passe",
            "es" => "Vuelva a introducir la contraseña",
            "de" => "Passwort erneut eingeben",
            "it" => "Reinserisci la password",
            _    => "Re-enter password"
        });

    var usernamePlaceholder = (!Loc["Placeholder_UsernameExample"].IsResourceNotFound && Loc["Placeholder_UsernameExample"].Value != "Placeholder_UsernameExample")
        ? Loc["Placeholder_UsernameExample"].Value
        : (currentCulture switch
        {
            "ar" => "مثال: john_cashier",
            "fr" => "ex. john_cashier",
            "es" => "ej. john_cashier",
            "de" => "z. B. john_cashier",
            "it" => "es. john_cashier",
            _    => "e.g., john_cashier"
        });

    var fullNamePlaceholder = (!Loc["Placeholder_FullNameExample"].IsResourceNotFound && Loc["Placeholder_FullNameExample"].Value != "Placeholder_FullNameExample")
        ? Loc["Placeholder_FullNameExample"].Value
        : (currentCulture switch
        {
            "ar" => "مثال: محمد أحمد",
            "fr" => "ex. Jean Dupont",
            "es" => "ej. Juan Pérez",
            "de" => "z. B. Max Mustermann",
            "it" => "es. Mario Rossi",
            _    => "e.g., John Doe"
        });

    var emailPlaceholder = (!Loc["Placeholder_EmailExample"].IsResourceNotFound && Loc["Placeholder_EmailExample"].Value != "Placeholder_EmailExample")
        ? Loc["Placeholder_EmailExample"].Value
        : (currentCulture switch
        {
            "ar" => "مثال: user@ims.local",
            "fr" => "ex. user@ims.local",
            "es" => "ej. user@ims.local",
            "de" => "z. B. user@ims.local",
            "it" => "es. user@ims.local",
            _    => "e.g., user@ims.local"
        });

    var passwordRequirementsLabel = (!Loc["Lbl_PasswordRequirements"].IsResourceNotFound && Loc["Lbl_PasswordRequirements"].Value != "Lbl_PasswordRequirements")
        ? Loc["Lbl_PasswordRequirements"].Value
        : (currentCulture switch
        {
            "ar" => "يجب أن تحتوي على حرف كبير وصغير ورقم ورمز خاص.",
            _ => "Must include upper, lower, digit, and special char."
        });

    var masterRecoveryKeyTitle = (!Loc["Lbl_MasterRecoveryKeyTitle"].IsResourceNotFound && Loc["Lbl_MasterRecoveryKeyTitle"].Value != "Lbl_MasterRecoveryKeyTitle")
        ? Loc["Lbl_MasterRecoveryKeyTitle"].Value
        : (currentCulture switch { "ar" => "مفتاح الاستعادة الرئيسي", _ => "Master Recovery Key" });

    var masterRecoveryKeyNotice = (!Loc["Lbl_MasterRecoveryKeyNotice"].IsResourceNotFound && Loc["Lbl_MasterRecoveryKeyNotice"].Value != "Lbl_MasterRecoveryKeyNotice")
        ? Loc["Lbl_MasterRecoveryKeyNotice"].Value
        : (currentCulture switch { "ar" => "سيتم إنشاء مفتاح استعادة رئيسي عشوائي ومشفّر تلقائياً عند إنشاء الحساب ويظهر لمرة واحدة فقط.", _ => "A cryptographically random Master Recovery Key will be automatically generated upon account creation and displayed strictly once." });
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0" style="font-weight: 800; color: var(--text-heading);">
            <i class="fas fa-user-plus text-primary mr-2"></i>@Loc["Lbl_CreateNewUser"]
        </h1>
        <p class="text-muted small mb-0 mt-1">@Loc["Lbl_CreateUserSubtitle"]</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: var(--radius-md);">
        <i class="fas fa-arrow-left mr-1"></i> @Loc["Lbl_BackToUsersList"]
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">
        <div class="card shadow-sm border-0 mb-4" style="background: var(--bg-surface); border-radius: var(--radius-lg); border: 1px solid var(--border-default) !important;">
            <div class="card-header py-3" style="background: var(--bg-surface-elevated); border-bottom: 1px solid var(--border-default);">
                <h6 class="m-0 font-weight-bold" style="color: var(--text-heading);">
                    <i class="fas fa-id-badge text-primary mr-2"></i>@Loc["Lbl_AccountCredentialsAndRole"]
                </h6>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-4" role="alert" style="border-radius: var(--radius-md);">
                            <div class="font-weight-bold mb-1"><i class="fas fa-exclamation-triangle mr-1"></i> @Loc["Lbl_PleaseCorrectErrors"]:</div>
                            <ul class="mb-0 pl-3">
                                @foreach (var modelState in ViewData.ModelState.Values)
                                {
                                    foreach (var error in modelState.Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <!-- Section 1: Basic Identity & Role -->
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">
                                @Loc["Username"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Username" class="form-control" placeholder="@usernamePlaceholder" required style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">
                                @Loc["FullName"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control" placeholder="@fullNamePlaceholder" required style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">
                                @Loc["Email"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Email" class="form-control" placeholder="@emailPlaceholder" required style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">
                                @Loc["Lbl_AssignedRole"] <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Role" class="form-control" required style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);">
                                @foreach (var r in roles)
                                {
                                    <option value="@r">@FormatRole(r)</option>
                                }
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr style="border-color: var(--border-subtle); margin: 1.5rem 0;" />

                    <!-- Section 2: Password Initialization -->
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">
                                @Loc["Password"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="@min8CharsPlaceholder" required style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);" />
                            <small class="text-muted">@passwordRequirementsLabel</small>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 form-group">
                            <label class="form-label" style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">
                                @Loc["Lbl_ConfirmPassword"] <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="@reenterPasswordPlaceholder" required style="background: var(--bg-input); border-color: var(--border-default); color: var(--text-main);" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr style="border-color: var(--border-subtle); margin: 1.5rem 0;" />

                    <!-- Section 3: Master Recovery Key (Zero SMTP) -->
                    <div class="card mb-3" style="background: var(--bg-surface-elevated); border: 1px solid var(--border-default); border-radius: var(--radius-md);">
                        <div class="card-body p-3">
                            <div class="d-flex align-items-start" style="gap: 0.85rem;">
                                <div style="width: 38px; height: 38px; border-radius: var(--radius-md); background: rgba(99, 102, 241, 0.15); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--primary);">
                                    <i class="fas fa-shield-alt"></i>
                                </div>
                                <div>
                                    <h6 class="font-weight-bold mb-1" style="color: var(--text-heading);">
                                        @masterRecoveryKeyTitle (Zero SMTP)
                                    </h6>
                                    <p class="text-muted small mb-0" style="line-height: 1.5;">
                                        @masterRecoveryKeyNotice
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-2">
                        <div class="custom-control custom-switch">
                            <input asp-for="IsActive" type="checkbox" class="custom-control-input" id="isActiveSwitch" checked />
                            <label class="custom-control-label" for="isActiveSwitch" style="color: var(--text-main); font-weight: 600; cursor: pointer;">
                                @Loc["Lbl_UserIsActiveAndCanLogin"]
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4" style="gap: 1rem;">
                        <a asp-action="Index" class="btn btn-secondary px-4 py-2" style="border-radius: var(--radius-md);">
                            @Loc["Cancel"]
                        </a>
                        <button type="submit" class="btn btn-primary px-4 py-2 font-weight-bold" style="border-radius: var(--radius-md); box-shadow: var(--primary-glow);">
                            <i class="fas fa-check mr-2"></i> @Loc["Lbl_CreateUserButton"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
