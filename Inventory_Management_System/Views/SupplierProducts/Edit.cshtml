@model Inventory_Management_System.ViewModels.SupplierProductFormViewModel
@using System.Globalization

@{
    ViewData["Title"] = Loc["EditMapping"].Value;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var supplierSkuPlaceholder = currentCulture switch
    {
        "ar" => "مثال: VEN-SKU-9921",
        "fr" => "ex. VEN-SKU-9921",
        "es" => "ej. VEN-SKU-9921",
        "de" => "z. B. VEN-SKU-9921",
        "it" => "es. VEN-SKU-9921",
        _    => "e.g. VEN-SKU-9921"
    };
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">@Loc["Nav_Dashboard"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">@Loc["Nav_SupplierMappings"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Loc["EditMapping"]</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-edit mr-2"></i>@Loc["EditMapping"]
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SupplierProductID" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="SupplierID" class="font-weight-bold">
                                    @Loc["Supplier"] <span class="text-danger">*</span>
                                </label>
                                <select asp-for="SupplierID" asp-items="Model.Suppliers" class="custom-select">
                                    <option value="0">— @Loc["SelectSupplier"] —</option>
                                </select>
                                <span asp-validation-for="SupplierID" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductID" class="font-weight-bold">
                                    @Loc["Product"] <span class="text-danger">*</span>
                                </label>
                                <select asp-for="ProductID" asp-items="Model.Products" class="custom-select">
                                    <option value="0">— @Loc["SelectProduct"] —</option>
                                </select>
                                <span asp-validation-for="ProductID" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="SupplierSKU" class="font-weight-bold">
                            @Loc["SupplierSKUPartNumber"] <span class="text-danger">*</span>
                        </label>
                        <input asp-for="SupplierSKU" class="form-control" placeholder="@supplierSkuPlaceholder" />
                        <small class="form-text text-muted">@Loc["SupplierSKUHelp"]</small>
                        <span asp-validation-for="SupplierSKU" class="text-danger small font-weight-bold"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ContractPrice" class="font-weight-bold">
                                    @Loc["ContractPrice"] ($) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ContractPrice" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                <small class="form-text text-muted">@Loc["ContractPriceHelp"]</small>
                                <span asp-validation-for="ContractPrice" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="LeadTimeDays" class="font-weight-bold">
                                    @Loc["LeadTimeDays"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="LeadTimeDays" class="form-control" type="number" min="1" max="365" placeholder="7" />
                                <small class="form-text text-muted">@Loc["LeadTimeHelp"]</small>
                                <span asp-validation-for="LeadTimeDays" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> @Loc["BackToList"]
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save mr-1"></i> @Loc["UpdateMapping"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
