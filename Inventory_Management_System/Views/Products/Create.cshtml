@model Inventory_Management_System.ViewModels.ProductFormViewModel
@using System.Globalization

@{
    ViewData["Title"] = Loc["AddNewProduct"].Value;
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var skuPlaceholder = currentCulture switch
    {
        "ar" => "مثال: SKU-001",
        "fr" => "ex. SKU-001",
        "es" => "ej. SKU-001",
        "de" => "z. B. SKU-001",
        "it" => "es. SKU-001",
        _    => "e.g. SKU-001"
    };
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent p-0 mb-3">
        <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Analytics">@Loc["Nav_Dashboard"]</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">@Loc["Nav_Products"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Loc["AddNewProduct"]</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-box mr-2"></i>@Loc["AddNewProduct"]
                </h6>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="SKU" class="font-weight-bold">
                                    @Loc["SKU"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="SKU" class="form-control" placeholder="@skuPlaceholder" autofocus />
                                <span asp-validation-for="SKU" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductName" class="font-weight-bold">
                                    @Loc["ProductName"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ProductName" class="form-control" placeholder="@Loc["ProductName"]" />
                                <span asp-validation-for="ProductName" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="CategoryID" class="font-weight-bold">
                            @Loc["Category"] <span class="text-danger">*</span>
                        </label>
                        <select asp-for="CategoryID" asp-items="Model.Categories" class="custom-select">
                            <option value="0">— @Loc["AllCategories"] —</option>
                        </select>
                        <span asp-validation-for="CategoryID" class="text-danger small font-weight-bold"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="UnitPrice" class="font-weight-bold">
                                    @Loc["UnitPrice"] ($) <span class="text-danger">*</span>
                                </label>
                                <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" />
                                <span asp-validation-for="UnitPrice" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="StockQuantity" class="font-weight-bold">
                                    @Loc["StockQuantity"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StockQuantity" class="form-control" type="number" min="0" placeholder="0" />
                                <span asp-validation-for="StockQuantity" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="LowStockThreshold" class="font-weight-bold">
                                    @Loc["Threshold"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="LowStockThreshold" class="form-control" type="number" min="0" placeholder="10" />
                                <span asp-validation-for="LowStockThreshold" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-1"></i> @Loc["BackToProducts"]
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="fas fa-save mr-1"></i> @Loc["Save"]
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
