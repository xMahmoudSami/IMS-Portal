    <!-- Global Themed Dialog & Alert Controller (Replaces native browser alert & confirm) -->
    <script>
        (function () {
            let activeResolve = null;

            function closeDialog(result) {
                const backdrop = $('#app-dialog-backdrop');
                backdrop.removeClass('is-visible');
                setTimeout(function () {
                    backdrop.hide().attr('aria-hidden', 'true');
                    if (typeof activeResolve === 'function') {
                        const cb = activeResolve;
                        activeResolve = null;
                        cb(result);
                    }
                }, 200);
            }

            window.appAlert = function (message, options) {
                return new Promise(function (resolve) {
                    activeResolve = resolve;
                    const opt = (typeof options === 'string')
                        ? { type: options }
                        : (options || {});

                    const dialogTrans = window.AppDialogTranslations || {};
                    const type = opt.type || 'info';
                    const defaultTitle =
                        type === 'danger' || type === 'error' ? (dialogTrans.error || 'Error!') :
                        type === 'warning' ? (dialogTrans.warning || 'Warning!') :
                        type === 'success' ? (dialogTrans.success || 'Success!') : (dialogTrans.info || 'Information');
                    const title = opt.title || defaultTitle;

                    const iconClass =
                        type === 'danger' || type === 'error' ? 'fa-times-circle' :
                        type === 'warning' ? 'fa-exclamation-triangle' :
                        type === 'success' ? 'fa-check-circle' : 'fa-info-circle';

                    const iconWrapper = $('#app-dialog-icon-wrapper');
                    iconWrapper.attr('class', 'app-dialog-icon-wrapper type-' + type);
                    $('#app-dialog-icon').attr('class', 'fas ' + iconClass);

                    $('#app-dialog-title').text(title);
                    $('#app-dialog-body').text(message || '');

                    $('#app-dialog-btn-cancel').hide();
                    const confirmBtn = $('#app-dialog-btn-confirm');
                    confirmBtn.text(opt.okText || opt.confirmText || dialogTrans.confirm || 'OK');
                    confirmBtn.attr('class', 'btn app-dialog-btn-confirm');
                    if (type === 'danger' || type === 'error') {
                        confirmBtn.addClass('btn-destructive');
                    } else if (type === 'warning') {
                        confirmBtn.addClass('btn-warning-dialog');
                    }

                    const backdrop = $('#app-dialog-backdrop');
                    backdrop.css('display', 'flex').attr('aria-hidden', 'false');
                    setTimeout(function () {
                        backdrop.addClass('is-visible');
                        confirmBtn.focus();
                    }, 20);
                });
            };

            window.appConfirm = function (message, options) {
                return new Promise(function (resolve) {
                    activeResolve = resolve;
                    const opt = (typeof options === 'string')
                        ? { title: options }
                        : (options || {});

                    const dialogTrans = window.AppDialogTranslations || {};
                    const type = opt.type || (opt.isDestructive ? 'danger' : 'warning');
                    const title = opt.title || dialogTrans.confirm || 'Confirm';

                    const iconClass =
                        type === 'danger' ? 'fa-trash-alt' :
                        type === 'warning' ? 'fa-exclamation-triangle' : 'fa-question-circle';

                    const iconWrapper = $('#app-dialog-icon-wrapper');
                    iconWrapper.attr('class', 'app-dialog-icon-wrapper type-' + type);
                    $('#app-dialog-icon').attr('class', 'fas ' + iconClass);

                    $('#app-dialog-title').text(title);
                    $('#app-dialog-body').text(message || '');

                    const cancelBtn = $('#app-dialog-btn-cancel');
                    cancelBtn.show().text(opt.cancelText || dialogTrans.cancel || 'Cancel');

                    const confirmBtn = $('#app-dialog-btn-confirm');
                    confirmBtn.text(opt.confirmText || dialogTrans.confirm || 'Confirm');
                    confirmBtn.attr('class', 'btn app-dialog-btn-confirm');
                    if (opt.isDestructive || type === 'danger') {
                        confirmBtn.addClass('btn-destructive');
                    } else if (type === 'warning') {
                        confirmBtn.addClass('btn-warning-dialog');
                    }

                    const backdrop = $('#app-dialog-backdrop');
                    backdrop.css('display', 'flex').attr('aria-hidden', 'false');
                    setTimeout(function () {
                        backdrop.addClass('is-visible');
                        confirmBtn.focus();
                    }, 20);
                });
            };

            // Wire dialog clicks
            $(document).on('click', '#app-dialog-btn-confirm', function (e) {
                e.preventDefault();
                closeDialog(true);
            });

            $(document).on('click', '#app-dialog-btn-cancel', function (e) {
                e.preventDefault();
                closeDialog(false);
            });

            $(document).on('click', '#app-dialog-backdrop', function (e) {
                if (e.target === this) {
                    closeDialog(false);
                }
            });

            $(document).on('keydown', function (e) {
                if (e.key === 'Escape' && $('#app-dialog-backdrop').hasClass('is-visible')) {
                    closeDialog(false);
                }
            });

            // Native alert override to route any alert() through the themed built-in dialog
            window.alert = function (message) {
                window.appAlert(message);
            };

            // Global themed confirmation handler for forms
            $(document).on('submit', 'form', async function (e) {
                var $form = $(this);
                if ($form.data('app-confirmed')) {
                    $form.removeData('app-confirmed');
                    return true;
                }

                var msg = $form.attr('data-confirm-message');
                var isDestructive = $form.attr('data-confirm-destructive') === 'true';
                var type = $form.attr('data-confirm-type') || (isDestructive ? 'danger' : 'warning');
                var title = $form.attr('data-confirm-title') || (window.AppDialogTranslations ? window.AppDialogTranslations.confirm : 'Confirm');

                if (!msg) {
                    var onsub = $form.attr('onsubmit');
                    if (onsub && onsub.indexOf('confirm(') !== -1) {
                        var match = onsub.match(/confirm\s*\(\s*(['"])(.*?)\1\s*\)/);
                        msg = match ? match[2] : 'Are you sure?';
                        isDestructive = true;
                        type = 'danger';
                    }
                }

                if (msg) {
                    e.preventDefault();
                    e.stopImmediatePropagation();

                    const confirmed = await window.appConfirm(msg, {
                        title: title,
                        type: type,
                        isDestructive: isDestructive
                    });

                    if (confirmed) {
                        $form.data('app-confirmed', true);
                        $form[0].submit();
                    }
                }
            });
        })();
    </script>
