    <!-- Global Search Script -->
    <script>
            $(document).ready(function () {

                let searchTimeout = null;

                $('#globalSearchInput').on('keyup input', function () {

                    let term = $(this).val().trim();
                    let dropdown = $('#searchResultsDropdown');

                    clearTimeout(searchTimeout);

                    if (term.length < 1) {
                        dropdown.hide().empty();
                        return;
                    }

                    searchTimeout = setTimeout(function () {

                        $.ajax({
                            url: '/Dashboard/GlobalSearch',
                            type: 'GET',
                            data: { term: term },

                            success: function (data) {

                                dropdown.empty();

                                let hasResults = false;
                                const lblProducts = '@Loc["Products"]';
                                const lblCategories = '@Loc["Categories"]';
                                const lblSuppliers = '@Loc["Suppliers"]';
                                const lblNoResults = '@Loc["NoResultsFound"]';

                                if (data.products && data.products.length > 0) {

                                    hasResults = true;

                                    dropdown.append(
                                        `<h6 class="dropdown-header">${lblProducts}</h6>`
                                    );

                                    $.each(data.products, function (i, item) {

                                        dropdown.append(`
                                            <a class="dropdown-item py-1"
                                               href="/Products/Details/${item.productID}">
                                                <div class="font-weight-bold text-dark">
                                                    ${item.productName}
                                                </div>
                                                <div class="small text-gray-500">
                                                    SKU: ${item.sku}
                                                </div>
                                            </a>
                                        `);

                                    });
                                }

                                if (data.categories && data.categories.length > 0) {

                                    hasResults = true;

                                    dropdown.append(
                                        `<h6 class="dropdown-header">${lblCategories}</h6>`
                                    );

                                    $.each(data.categories, function (i, item) {

                                        dropdown.append(`
                                            <a class="dropdown-item py-1"
                                               href="/Categories/Details/${item.categoryID}">
                                                <div class="font-weight-bold text-dark">
                                                    ${item.categoryName}
                                                </div>
                                            </a>
                                        `);

                                    });
                                }

                                if (data.suppliers && data.suppliers.length > 0) {

                                    hasResults = true;

                                    dropdown.append(
                                        `<h6 class="dropdown-header">${lblSuppliers}</h6>`
                                    );

                                    $.each(data.suppliers, function (i, item) {

                                        dropdown.append(`
                                            <a class="dropdown-item py-1"
                                               href="/Suppliers/Details/${item.supplierID}">
                                                <div class="font-weight-bold text-dark">
                                                    ${item.supplierName}
                                                </div>
                                            </a>
                                        `);

                                    });
                                }

                                if (hasResults) {
                                    dropdown.show();
                                }
                                else {
                                    dropdown.append(
                                        `<div class="dropdown-item small text-gray-500 p-2 text-center">${lblNoResults}</div>`
                                    );

                                    dropdown.show();
                                }
                            },

                            error: function () {
                                dropdown.hide().empty();
                            }
                        });

                    }, 300);

                });

                $(document).on('click', function (e) {

                    if (!$(e.target).closest('.navbar-search').length) {
                        $('#searchResultsDropdown').hide();
                    }

                });

            });
    </script>

    <!-- AI Chatbot Script -->
    <script>
            $(document).ready(function () {

                // Initialize / synchronize localized text from window.ChatbotTranslations or data attributes
                const chatContainer = $('#ai-chatbot, #ai-chat-widget');
                const translations = window.ChatbotTranslations || {
                    title: chatContainer.attr('data-title'),
                    greeting: chatContainer.attr('data-greeting'),
                    placeholder: chatContainer.attr('data-placeholder'),
                    clearTooltip: chatContainer.attr('data-clear-tooltip'),
                    clearConfirm: 'Are you sure you want to clear the chat history?'
                };

                if (translations) {
                    if (translations.title && $('#ai-chat-title-text').length) {
                        $('#ai-chat-title-text').text(translations.title);
                    }
                    if (translations.greeting && $('#ai-initial-greeting').length) {
                        $('#ai-initial-greeting').text(translations.greeting);
                    }
                    if (translations.placeholder && $('#ai-chat-input').length) {
                        $('#ai-chat-input').attr('placeholder', translations.placeholder);
                    }
                    if (translations.clearTooltip && $('#ai-chat-clear').length) {
                        $('#ai-chat-clear').attr('title', translations.clearTooltip);
                    }
                }

                // Remove #page-top scroll button completely from DOM
                function purgeScrollToTop() {
                    $('.scroll-to-top, a[href="#page-top"], a[href$="#page-top"]').remove();
                }
                purgeScrollToTop();
                $(window).on('scroll', purgeScrollToTop);

                // Helper: escape HTML for user messages
                function escapeHtml(text) {
                    if (!text) return '';
                    return $('<div>').text(text).html();
                }

                // Helper: format ISO timestamp to localized time
                function formatMessageTime(dateString) {
                    if (!dateString) return '';
                    try {
                        const date = new Date(dateString);
                        if (isNaN(date.getTime())) return '';
                        return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    } catch (e) {
                        return '';
                    }
                }

                function scrollChatToBottom(smooth = false) {
                    const messages = $('#ai-chat-messages');
                    if (!messages.length || !messages[0]) return;

                    if (smooth) {
                        messages.stop().animate({
                            scrollTop: messages[0].scrollHeight
                        }, 300);
                    } else {
                        messages.scrollTop(messages[0].scrollHeight);
                    }
                }

                function renderUserMessage(text, timestamp) {
                    const timeHtml = timestamp ? `<div class="message-time">${formatMessageTime(timestamp)}</div>` : '';
                    return `
                        <div class="user-message">
                            <div class="message-content">${escapeHtml(text)}</div>
                            ${timeHtml}
                        </div>
                    `;
                }

                function formatMarkdownFallback(raw) {
                    if (!raw) return '';
                    let str = escapeHtml(raw);
                    // Code blocks
                    str = str.replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>');
                    // Inline code
                    str = str.replace(/`([^`]+)`/g, '<code>$1</code>');
                    // Headers
                    str = str.replace(/^### (.*$)/gim, '<h4>$1</h4>');
                    str = str.replace(/^## (.*$)/gim, '<h3>$1</h3>');
                    str = str.replace(/^# (.*$)/gim, '<h2>$1</h2>');
                    // Bold
                    str = str.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                    // Italic
                    str = str.replace(/\*([^\*]+)\*/g, '<em>$1</em>');
                    // Bullet points
                    str = str.replace(/^[\s]*[•\-\*]\s+(.*$)/gim, '<li>$1</li>');
                    str = str.replace(/(<li>[\s\S]*?<\/li>)/gi, '<ul>$1</ul>');
                    str = str.replace(/<\/ul>\s*<ul>/gi, '');
                    // Line breaks
                    str = str.replace(/\n/g, '<br/>');
                    return str;
                }

                function renderAIMessage(text, timestamp) {
                    let rendered = text || '';
                    const markedObj = (typeof marked !== 'undefined') ? marked : (typeof window !== 'undefined' ? window.marked : null);

                    if (markedObj && typeof markedObj.parse === 'function') {
                        try {
                            if (typeof markedObj.use === 'function') {
                                markedObj.use({ breaks: true, gfm: true });
                            }
                            rendered = markedObj.parse(rendered);
                        } catch (e) {
                            console.warn('marked.parse error, using fallback:', e);
                            rendered = formatMarkdownFallback(rendered);
                        }
                    } else if (typeof markedObj === 'function') {
                        try {
                            rendered = markedObj(rendered);
                        } catch (e) {
                            rendered = formatMarkdownFallback(rendered);
                        }
                    } else {
                        rendered = formatMarkdownFallback(rendered);
                    }

                    let safe = rendered;
                    const purifyObj = (typeof DOMPurify !== 'undefined') ? DOMPurify : (typeof window !== 'undefined' ? window.DOMPurify : null);
                    if (purifyObj && typeof purifyObj.sanitize === 'function') {
                        try {
                            safe = purifyObj.sanitize(rendered, {
                                USE_PROFILES: { html: true }
                            });
                        } catch (e) {
                            console.warn('DOMPurify error:', e);
                        }
                    }

                    const timeHtml = timestamp ? `<div class="message-time">${formatMessageTime(timestamp)}</div>` : '';
                    return `
                        <div class="ai-message ai-markdown">
                            <div class="message-content">${safe}</div>
                            ${timeHtml}
                        </div>
                    `;
                }

                function renderInitialGreeting() {
                    const greetingText = (translations && translations.greeting)
                        ? translations.greeting
                        : "Hello! I'm your inventory assistant. How can I help you?";
                    return `
                        <div class="ai-message" id="ai-initial-greeting">
                            <div class="message-content">${greetingText}</div>
                        </div>
                    `;
                }

                let isHistoryLoaded = false;
                let isLoadingHistory = false;

                // Load and hydrate chat history from the database
                function loadChatHistory(smoothScroll = true) {
                    if (isLoadingHistory) return;
                    isLoadingHistory = true;

                    $.ajax({
                        url: '/api/AI/history',
                        type: 'GET',
                        cache: false,
                        success: function (data) {
                            isLoadingHistory = false;
                            isHistoryLoaded = true;

                            const logs = Array.isArray(data) ? data : (data && (data.data || data.history || []));
                            const messagesContainer = $('#ai-chat-messages');

                            if (logs && logs.length > 0) {
                                messagesContainer.empty();
                                logs.forEach(function (log) {
                                    const userQuery = log.userQuery || log.userMessage || log.message || log.question;
                                    const aiResponse = log.aiResponse || log.response;
                                    const timestamp = log.createdAt || log.timestamp;

                                    if (userQuery) {
                                        messagesContainer.append(renderUserMessage(userQuery, timestamp));
                                    }
                                    if (aiResponse) {
                                        messagesContainer.append(renderAIMessage(aiResponse, timestamp));
                                    }
                                });
                            } else {
                                messagesContainer.html(renderInitialGreeting());
                            }

                            scrollChatToBottom(smoothScroll);
                        },
                        error: function (xhr) {
                            isLoadingHistory = false;
                            console.error('Failed to load chat history:', xhr);
                            if (!$('#ai-chat-messages').children().length) {
                                $('#ai-chat-messages').html(renderInitialGreeting());
                            }
                        }
                    });
                }

                // Toggle AI Chatbot with smooth animations
                function toggleChat(open) {
                    const chatWindow = $('#ai-chat-window');
                    const chatButton = $('#ai-chat-button');
                    const isOpen = chatWindow.hasClass('is-open');
                    const shouldOpen = (open !== undefined) ? open : !isOpen;

                    if (shouldOpen) {
                        chatWindow.addClass('is-open');
                        chatButton.addClass('chat-is-open');
                        try {
                            sessionStorage.setItem('ai_chat_open', 'true');
                        } catch (e) { }

                        if (!isHistoryLoaded) {
                            loadChatHistory(true);
                        } else {
                            setTimeout(function () {
                                scrollChatToBottom(true);
                            }, 100);
                        }

                        setTimeout(function () {
                            $('#ai-chat-input').focus();
                        }, 250);
                    } else {
                        chatWindow.removeClass('is-open');
                        chatButton.removeClass('chat-is-open');
                        try {
                            sessionStorage.setItem('ai_chat_open', 'false');
                        } catch (e) { }
                    }
                }

                // Initial history hydration
                loadChatHistory(false);

                // Restore open state across navigations if previously opened
                try {
                    if (sessionStorage.getItem('ai_chat_open') === 'true') {
                        toggleChat(true);
                    }
                } catch (e) { }

                // Open / close on FAB click
                $('#ai-chat-button').on('click', function (e) {
                    e.stopPropagation();
                    toggleChat();
                });

                // Close on header close button click
                $('#ai-chat-close').on('click', function (e) {
                    e.stopPropagation();
                    toggleChat(false);
                });

                // Clear history button click
                $('#ai-chat-clear').on('click', async function (e) {
                    e.stopPropagation();

                    const confirmMsg = (translations && translations.clearConfirm)
                        ? translations.clearConfirm
                        : 'Are you sure you want to clear the chat history?';

                    const dialogTrans = window.AppDialogTranslations || {};
                    const confirmed = await window.appConfirm(confirmMsg, {
                        title: translations && translations.title ? translations.title : (dialogTrans.info || 'AI Inventory Assistant'),
                        type: 'warning',
                        confirmText: translations && translations.confirm ? translations.confirm : (dialogTrans.confirm || 'Confirm'),
                        cancelText: translations && translations.cancel ? translations.cancel : (dialogTrans.cancel || 'Cancel'),
                        isDestructive: true
                    });

                    if (!confirmed) {
                        return;
                    }

                    const clearBtn = $(this);
                    clearBtn.prop('disabled', true);

                    $.ajax({
                        url: '/api/AI/clear',
                        type: 'POST',
                        success: function () {
                            clearBtn.prop('disabled', false);
                            $('#ai-chat-messages').html(renderInitialGreeting());
                            scrollChatToBottom(false);
                        },
                        error: function (xhr) {
                            clearBtn.prop('disabled', false);
                            console.error('Failed to clear chat history:', xhr);
                            window.appAlert('Failed to clear chat history. Please try again.', { type: 'danger' });
                        }
                    });
                });

                // Close when clicking outside chat window
                $(document).on('click', function (e) {
                    if (!$(e.target).closest('#ai-chatbot, #ai-chat-widget').length) {
                        if ($('#ai-chat-window').hasClass('is-open')) {
                            toggleChat(false);
                        }
                    }
                });

                // Close on ESC key
                $(document).on('keydown', function (e) {
                    if (e.key === 'Escape' && $('#ai-chat-window').hasClass('is-open')) {
                        toggleChat(false);
                    }
                });

                // Send message
                $('#ai-chat-send').click(function () {
                    sendAIMessage();
                });

                // Send with Enter
                $('#ai-chat-input').keypress(function (e) {
                    if (e.which === 13) {
                        sendAIMessage();
                    }
                });

                function sendAIMessage() {
                    const input = $('#ai-chat-input');
                    const message = input.val().trim();

                    if (!message) {
                        return;
                    }

                    // Remove initial greeting if visible
                    $('#ai-initial-greeting').remove();

                    const now = new Date().toISOString();

                    // Show user message
                    $('#ai-chat-messages').append(renderUserMessage(message, now));

                    input.val('');

                    // Localized Loading & Error Messages
                    const currentLang = $('html').attr('lang') || 'en';
                    const loadingText = currentLang === 'ar' ? 'جارٍ التفكير...' :
                                        currentLang === 'fr' ? 'Réflexion en course...' :
                                        currentLang === 'es' ? 'Pensando...' :
                                        currentLang === 'it' ? 'Sto pensando...' :
                                        currentLang === 'de' ? 'Ich denke nach...' : 'Thinking...';

                    const errorText = currentLang === 'ar' ? 'عذراً، حدث خطأ ما. يرجى المحاولة مرة أخرى.' :
                                      currentLang === 'fr' ? 'Désolé, une erreur s\'est produite. Veuillez réessayer.' :
                                      currentLang === 'es' ? 'Lo sentimos, algo salió mal. Inténtalo de nuevo.' :
                                      currentLang === 'it' ? 'Spiacenti, si è verification un errore. Riprova.' :
                                      currentLang === 'de' ? 'Entschuldigung, etwas ist schiefgelaufen. Bitte versuchen Sie es erneut.' : 'Sorry, something went wrong. Please try again.';

                    // Loading message
                    const loadingMessage = $(`
                        <div class="ai-message" id="ai-loading">
                            <i class="fas fa-spinner fa-spin mr-2"></i> ${loadingText}
                        </div>
                    `);

                    $('#ai-chat-messages').append(loadingMessage);
                    scrollChatToBottom(true);

                    // Call C# API
                    $.ajax({
                        url: '/api/AI/chat',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            message: message
                        }),
                        success: function (data) {
                            $('#ai-loading').remove();

                            const responseText = data.response || data.aiResponse || '';
                            const createdAt = data.createdAt || new Date().toISOString();

                            $('#ai-chat-messages').append(renderAIMessage(responseText, createdAt));
                            scrollChatToBottom(true);
                        },
                        error: function (xhr) {
                            $('#ai-loading').remove();

                            $('#ai-chat-messages').append(`
                                <div class="ai-message">
                                    ${errorText}
                                </div>
                            `);

                            console.error('Chat error:', xhr);
                            scrollChatToBottom(true);
                        }
                    });
                }

            });
    </script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html> 