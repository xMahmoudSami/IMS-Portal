@inject Inventory_Management_System.Models.ApplicationDbContext _context
@using System.Globalization
@{
    // ── Culture & RTL Detection ──────────────────────────────────────────
    var currentCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName;
    var isRtl = currentCulture.Equals("ar", StringComparison.OrdinalIgnoreCase);
    var lowStockProducts = _context.Products
        .Where(p => p.StockQuantity <= p.LowStockThreshold)
        .OrderBy(p => p.StockQuantity)
        .Take(5)
        .Select(p => new
        {
            p.ProductID,
            p.ProductName,
            p.StockQuantity,
            p.LowStockThreshold,
            p.SKU
        })
        .ToList();

    var lowStockCount = _context.Products
        .Count(p => p.StockQuantity <= p.LowStockThreshold);

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()
        ?? ViewContext.ActionDescriptor.RouteValues["controller"]
        ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString()
        ?? ViewContext.ActionDescriptor.RouteValues["action"]
        ?? "";
    var currentPath = Context.Request.Path.Value?.TrimEnd('/') ?? "";

    bool isDashboardActive = string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrEmpty(currentPath)
        || string.Equals(currentPath, "/dashboard", StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentPath, "/dashboard/analytics", StringComparison.OrdinalIgnoreCase);

    bool IsActive(string controller, string? action = null)
    {
        if (string.Equals(controller, "Dashboard", StringComparison.OrdinalIgnoreCase))
            return isDashboardActive;

        if (!string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase))
            return false;
        if (!string.IsNullOrEmpty(action))
            return string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return true;
    }

    bool IsProductsListActive()
    {
        if (!string.Equals(currentController, "Products", StringComparison.OrdinalIgnoreCase))
            return false;
        return !string.Equals(currentAction, "Create", StringComparison.OrdinalIgnoreCase);
    }

    // ── User Role & RBAC Permissions ─────────────────────────────────────
    bool isSuperAdmin = User.IsInRole(AppRoles.SuperAdmin);
    bool isWarehouseManager = User.IsInRole(AppRoles.WarehouseManager);
    bool isCashier = User.IsInRole(AppRoles.Cashier);
    bool isProcurement = User.IsInRole(AppRoles.ProcurementSpecialist);
    bool isAuditor = User.IsInRole(AppRoles.Auditor);

    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value
        ?? (isSuperAdmin ? AppRoles.SuperAdmin :
            isWarehouseManager ? AppRoles.WarehouseManager :
            isCashier ? AppRoles.Cashier :
            isProcurement ? AppRoles.ProcurementSpecialist :
            isAuditor ? AppRoles.Auditor : "User");

    var roleBadgeClass = userRole switch
    {
        AppRoles.SuperAdmin => "badge-danger",
        AppRoles.WarehouseManager => "badge-primary",
        AppRoles.Cashier => "badge-success",
        AppRoles.ProcurementSpecialist => "badge-info",
        AppRoles.Auditor => "badge-warning",
        _ => "badge-secondary"
    };

    string FormatRole(string r)
    {
        var key = "Role_" + r;
        var localized = Loc[key];
        if (!localized.IsResourceNotFound && !string.IsNullOrWhiteSpace(localized.Value) && localized.Value != key)
        {
            return localized.Value;
        }

        return currentCulture switch
        {
            "ar" => r switch
            {
                AppRoles.SuperAdmin => "المشرف العام",
                AppRoles.WarehouseManager => "مدير المستودع",
                AppRoles.Cashier => "أمين الصندوق",
                AppRoles.ProcurementSpecialist => "مسؤول المشتريات",
                AppRoles.Auditor => "مدقق مالي",
                _ => r
            },
            "fr" => r switch
            {
                AppRoles.SuperAdmin => "Administrateur",
                AppRoles.WarehouseManager => "Gestionnaire d'entrepôt",
                AppRoles.Cashier => "Caissier",
                AppRoles.ProcurementSpecialist => "Responsable des achats",
                AppRoles.Auditor => "Auditeur",
                _ => r
            },
            "es" => r switch
            {
                AppRoles.SuperAdmin => "Administrador",
                AppRoles.WarehouseManager => "Gerente de almacén",
                AppRoles.Cashier => "Cajero",
                AppRoles.ProcurementSpecialist => "Especialista en compras",
                AppRoles.Auditor => "Auditor",
                _ => r
            },
            "de" => r switch
            {
                AppRoles.SuperAdmin => "Administrator",
                AppRoles.WarehouseManager => "Lagermanager",
                AppRoles.Cashier => "Kassierer",
                AppRoles.ProcurementSpecialist => "Beschaffungsspezialist",
                AppRoles.Auditor => "Prüfer",
                _ => r
            },
            "it" => r switch
            {
                AppRoles.SuperAdmin => "Amministratore",
                AppRoles.WarehouseManager => "Responsabile del magazzino",
                AppRoles.Cashier => "Cassiere",
                AppRoles.ProcurementSpecialist => "Addetto agli acquisti",
                AppRoles.Auditor => "Revisore dei conti",
                _ => r
            },
            _ => r switch
            {
                AppRoles.SuperAdmin => "Administrator",
                AppRoles.WarehouseManager => "Warehouse Manager",
                AppRoles.Cashier => "Cashier",
                AppRoles.ProcurementSpecialist => "Procurement Specialist",
                AppRoles.Auditor => "Auditor",
                _ => r
            }
        };
    }

    var displayUserRole = FormatRole(userRole);

    bool canViewDashboard = isSuperAdmin || isWarehouseManager || isProcurement || isAuditor;
    bool canViewProducts = isSuperAdmin || isWarehouseManager || isCashier || isProcurement || isAuditor;
    bool canManageProducts = isSuperAdmin || isWarehouseManager;
    bool canViewCategories = isSuperAdmin || isWarehouseManager || isAuditor;
    bool canViewSuppliers = isSuperAdmin || isWarehouseManager || isProcurement || isAuditor;
    bool canViewSupplierProducts = isSuperAdmin || isWarehouseManager || isProcurement;
    bool canViewPurchases = isSuperAdmin || isWarehouseManager || isProcurement || isAuditor;
    bool canViewSales = isSuperAdmin || isCashier || isAuditor;
    bool canViewReports = isSuperAdmin || isAuditor || isWarehouseManager;
    bool canViewSalesReport = isSuperAdmin || isAuditor;
    bool canManageUsers = isSuperAdmin;

    // ── Localized Administration Section Heading ─────────────────────
    var navAdministration = Loc["Nav_Administration"].IsResourceNotFound || Loc["Nav_Administration"].Value == "Nav_Administration"
        ? (currentCulture switch
        {
            "ar" => "إدارة النظام",
            "fr" => "Administration",
            "es" => "Administración",
            "it" => "Amministrazione",
            "de" => "Verwaltung",
            _    => "Administration"
        })
        : Loc["Nav_Administration"].Value;

    // ── Localized Chatbot Strings with culture-aware fallbacks ────────
    var chatTitle = Loc["AIChatbotTitle"].IsResourceNotFound || Loc["AIChatbotTitle"].Value == "AIChatbotTitle"
        ? (currentCulture switch
        {
            "ar" => "المساعد الذكي للمخزون",
            "fr" => "Assistant d'inventaire IA",
            "es" => "Asistente de inventor IA",
            "it" => "Assistente inventor IA",
            "de" => "KI-Inventar-Assistent",
            _ => "AI Inventory Assistant"
        })
        : Loc["AIChatbotTitle"].Value;

    var chatGreeting = Loc["AIChatGreeting"].IsResourceNotFound || Loc["AIChatGreeting"].Value == "AIChatGreeting"
        ? (currentCulture switch
        {
            "ar" => "مرحباً! أنا مساعدك الذكي للمخزون، كيف يمكنني مساعدتك اليوم؟",
            "fr" => "Bonjour! Je suis votre assistant d'inventaire. Comment puis-je vous aider?",
            "es" => "¡Hola! Soy tu asistente de inventor. ¿Cómo puedo ayudarte?",
            "it" => "Ciao! Sono il tuo assistente inventor. Come posso aiutarti?",
            "de" => "Hallo! Ich bin Ihr Inventar-Assistent. Wie kann ich Ihnen helfen?",
            _ => "Hello! I'm your inventory assistant. How can I help you?"
        })
        : Loc["AIChatGreeting"].Value;

    var chatPlaceholder = Loc["AskAIPlaceholder"].IsResourceNotFound || Loc["AskAIPlaceholder"].Value == "AskAIPlaceholder"
        ? (currentCulture switch
        {
            "ar" => "اسأل عن مخزونك...",
            "fr" => "Posez une question sur votre inventaire...",
            "es" => "Pregunte sobre su inventor...",
            "it" => "Chiedi informazioni sul tuo inventor...",
            "de" => "Fragen Sie nach Ihrem Inventar...",
            _ => "Ask about your inventory..."
        })
        : Loc["AskAIPlaceholder"].Value;

    var chatClearTooltip = Loc["ClearChatHistory"].IsResourceNotFound || Loc["ClearChatHistory"].Value == "ClearChatHistory"
        ? (currentCulture switch
        {
            "ar" => "مسح سجل المحادثة",
            "fr" => "Effacer l'historique",
            "es" => "Borrar historical",
            "it" => "Cancella cronologia",
            "de" => "Verlauf löschen",
            _ => "Clear chat history"
        })
        : Loc["ClearChatHistory"].Value;

    var chatClearConfirm = Loc["ClearChatConfirm"].IsResourceNotFound || Loc["ClearChatConfirm"].Value == "ClearChatConfirm"
        ? (currentCulture switch
        {
            "ar" => "هل أنت متأكد من مسح جميع رسائل المحادثة؟",
            "fr" => "Êtes-vous sûr de vouloir effacer tout l'historique du chat ?",
            "es" => "¿Estás seguro de que deseas borrar todo el historical de chat?",
            "it" => "Sei sicuro di voler cancellare l'intera cronologia della chat?",
            "de" => "Möchten Sie wirklich den gesamten Chat-Verlauf löschen?",
            _ => "Are you sure you want to clear the entire chat history?"
        })
        : Loc["ClearChatConfirm"].Value;

    var dialogConfirmText = Loc["Confirm"].IsResourceNotFound || Loc["Confirm"].Value == "Confirm"
        ? (currentCulture switch
        {
            "ar" => "تأكيد",
            "fr" => "Confirmer",
            "es" => "Confirmar",
            "it" => "Conferma",
            "de" => "Bestätigen",
            _ => "Confirm"
        })
        : Loc["Confirm"].Value;

    var dialogCancelText = Loc["Cancel"].IsResourceNotFound || Loc["Cancel"].Value == "Cancel"
        ? (currentCulture switch
        {
            "ar" => "إلغاء",
            "fr" => "Annuler",
            "es" => "Cancelar",
            "it" => "Annulla",
            "de" => "Abbrechen",
            _ => "Cancel"
        })
        : Loc["Cancel"].Value;

    var dialogErrorText = Loc["Error"].IsResourceNotFound || Loc["Error"].Value == "Error"
        ? (currentCulture switch
        {
            "ar" => "خطأ!",
            "fr" => "Erreur !",
            "es" => "¡Error!",
            "it" => "Errore!",
            "de" => "Fehler!",
            _ => "Error!"
        })
        : Loc["Error"].Value;

    var dialogWarningText = Loc["Warning"].IsResourceNotFound || Loc["Warning"].Value == "Warning"
        ? (currentCulture switch
        {
            "ar" => "تحذير!",
            "fr" => "Attention !",
            "es" => "¡Advertencia!",
            "it" => "Avviso!",
            "de" => "Warnung!",
            _ => "Warning!"
        })
        : Loc["Warning"].Value;

    var dialogSuccessText = Loc["Success"].IsResourceNotFound || Loc["Success"].Value == "Success"
        ? (currentCulture switch
        {
            "ar" => "تم بنجاح!",
            "fr" => "Succès !",
            "es" => "¡Éxito!",
            "it" => "Operazione riuscita!",
            "de" => "Erfolg!",
            _ => "Success!"
        })
        : Loc["Success"].Value;
    var themeCookie = Context.Request.Cookies["ims_theme"];
    if (themeCookie != "light" && themeCookie != "dark") { themeCookie = Context.Request.Cookies["theme"]; }
    if (themeCookie != "light" && themeCookie != "dark") { themeCookie = "dark"; }
}

<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isRtl ? "rtl" : "ltr")" data-theme="@themeCookie">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <!-- Anti-flicker theme detection (runs synchronously before styles render) -->
    <script>
            (function () {
                try {
                    var saved = localStorage.getItem('ims_theme');
                    if (saved !== 'light' && saved !== 'dark') {
                        saved = '@themeCookie';
                    }
                    if (saved !== 'light' && saved !== 'dark') {
                        saved = 'dark';
                    }
                    document.documentElement.setAttribute('data-theme', saved);
                    try { localStorage.setItem('ims_theme', saved); } catch (e) { }
                    document.cookie = 'ims_theme=' + saved + ';path=/;max-age=31536000;SameSite=Lax';
                } catch (e) { }
            })();
    </script>
    @if (!string.IsNullOrEmpty(ViewData["DocumentTitle"]?.ToString()))
    {
        <title>@ViewData["DocumentTitle"]</title>
    }
    else if (!string.IsNullOrEmpty(ViewData["Title"]?.ToString()))
    {
        <title>@ViewData["Title"] - Inventory Management System</title>
    }
    else
    {
        <title>Inventory Management System</title>
    }

    <!-- Custom fonts -->
    <link href="~/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />

    <!-- Custom styles -->
    <link href="~/css/sb-admin-2.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/ai-chat.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    @* RTL overrides — loaded only for Arabic culture *@
    @if (isRtl)
    {
        <link href="~/css/rtl.css" rel="stylesheet" asp-append-version="true" />
    }
</head>

<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

            <!-- Sidebar - Brand -->
            <a class="sidebar-brand d-flex align-items-center justify-content-center"
               asp-controller="Dashboard"
               asp-action="Analytics">
                <div class="sidebar-brand-icon rotate-n-15">
                    <i class="fas fa-boxes"></i>
                </div>
                <div class="sidebar-brand-text mx-3">IMS Portal</div>
            </a>

            <hr class="sidebar-divider my-0" />

            @if (canViewDashboard)
            {
                <!-- Dashboard -->
                <li class="nav-item @(IsActive("Dashboard") ? "active-page" : "")">
                    <a class="nav-link @(IsActive("Dashboard") ? "active-page" : "")"
                       asp-controller="Dashboard"
                       asp-action="Analytics">
                        <i class="fas fa-fw fa-tachometer-alt"></i>
                        <span>@SharedLocalizer["Nav_Dashboard"]</span>
                    </a>
                </li>

                <hr class="sidebar-divider" />
            }

            @if (canViewProducts || canViewCategories || canViewSuppliers || canViewSupplierProducts)
            {
                <!-- INVENTORY CORE -->
                <div class="sidebar-heading">@SharedLocalizer["Nav_InventoryCore"]</div>

                @if (canViewProducts)
                {
                    <!-- Products -->
                    <li class="nav-item">
                        <a class="nav-link @(IsActive("Products") ? "" : "collapsed")"
                           href="#"
                           data-toggle="collapse"
                           data-target="#collapseProducts"
                           aria-expanded="@(IsActive("Products") ? "true" : "false")"
                           aria-controls="collapseProducts">
                            <i class="fas fa-fw fa-box"></i>
                            <span>@SharedLocalizer["Nav_Products"]</span>
                            <i class="fas fa-angle-right ml-auto sidebar-chevron"></i>
                        </a>

                        <div id="collapseProducts"
                             class="collapse @(IsActive("Products") ? "show" : "")"
                             data-parent="#accordionSidebar">

                            <a class="nav-link py-2 @(IsProductsListActive() ? "active-page" : "")"
                               asp-controller="Products"
                               asp-action="Index">
                                <span>@SharedLocalizer["Nav_AllProducts"]</span>
                            </a>

                            @if (canManageProducts)
                            {
                                <a class="nav-link py-2 @(IsActive("Products", "Create") ? "active-page" : "")"
                                   asp-controller="Products"
                                   asp-action="Create">
                                    <span>@SharedLocalizer["Nav_AddProduct"]</span>
                                </a>
                            }
                        </div>
                    </li>
                }

                @if (canViewCategories)
                {
                    <!-- Categories -->
                    <li class="nav-item @(IsActive("Categories") ? "active-page" : "")">
                        <a class="nav-link @(IsActive("Categories") ? "active-page" : "")"
                           asp-controller="Categories"
                           asp-action="Index">
                            <i class="fas fa-fw fa-tags"></i>
                            <span>@SharedLocalizer["Nav_Categories"]</span>
                        </a>
                    </li>
                }

                @if (canViewSuppliers)
                {
                    <!-- Suppliers -->
                    <li class="nav-item @(IsActive("Suppliers") ? "active-page" : "")">
                        <a class="nav-link @(IsActive("Suppliers") ? "active-page" : "")"
                           asp-controller="Suppliers"
                           asp-action="Index">
                            <i class="fas fa-fw fa-truck"></i>
                            <span>@SharedLocalizer["Nav_Suppliers"]</span>
                        </a>
                    </li>
                }

                @if (canViewSupplierProducts)
                {
                    <!-- Supplier Mappings -->
                    <li class="nav-item @(IsActive("SupplierProducts") ? "active-page" : "")">
                        <a class="nav-link @(IsActive("SupplierProducts") ? "active-page" : "")"
                           asp-controller="SupplierProducts"
                           asp-action="Index">
                            <i class="fas fa-fw fa-handshake"></i>
                            <span>@SharedLocalizer["Nav_SupplierMappings"]</span>
                        </a>
                    </li>
                }

                <hr class="sidebar-divider" />
            }

            @if (canViewPurchases || canViewSales)
            {
                <!-- TRANSACTIONS -->
                <div class="sidebar-heading">@SharedLocalizer["Nav_Transactions"]</div>

                <li class="nav-item">
                    <a class="nav-link @(IsActive("Purchases") || IsActive("Sales") ? "" : "collapsed")"
                       href="#"
                       data-toggle="collapse"
                       data-target="#collapseTransactions"
                       aria-expanded="@(IsActive("Purchases") || IsActive("Sales") ? "true" : "false")"
                       aria-controls="collapseTransactions">
                        <i class="fas fa-fw fa-exchange-alt"></i>
                        <span>@SharedLocalizer["Nav_Transactions"]</span>
                        <i class="fas fa-angle-right ml-auto sidebar-chevron"></i>
                    </a>

                    <div id="collapseTransactions"
                         class="collapse @(IsActive("Purchases") || IsActive("Sales") ? "show" : "")"
                         data-parent="#accordionSidebar">

                        @if (canViewPurchases)
                        {
                            <a class="nav-link py-2 @(IsActive("Purchases") ? "active-page" : "")"
                               asp-controller="Purchases"
                               asp-action="Index">
                                <span>@SharedLocalizer["Nav_Purchases"]</span>
                            </a>
                        }

                        @if (canViewSales)
                        {
                            <a class="nav-link py-2 @(IsActive("Sales") ? "active-page" : "")"
                               asp-controller="Sales"
                               asp-action="Index">
                                <span>@SharedLocalizer["Nav_Sales"]</span>
                            </a>
                        }
                    </div>
                </li>

                <hr class="sidebar-divider" />
            }

            @if (canViewReports)
            {
                <!-- MANAGEMENT -->
                <div class="sidebar-heading">@SharedLocalizer["Nav_Management"]</div>

                <!-- Reports -->
                <li class="nav-item">
                    <a class="nav-link @(IsActive("Reports") ? "" : "collapsed")"
                       href="#"
                       data-toggle="collapse"
                       data-target="#collapseReports"
                       aria-expanded="@(IsActive("Reports") ? "true" : "false")"
                       aria-controls="collapseReports">
                        <i class="fas fa-fw fa-chart-line"></i>
                        <span>@SharedLocalizer["Nav_Reports"]</span>
                        <i class="fas fa-angle-right ml-auto sidebar-chevron"></i>
                    </a>

                    <div id="collapseReports"
                         class="collapse @(IsActive("Reports") ? "show" : "")"
                         data-parent="#accordionSidebar">

                        <a class="nav-link py-2 @(IsActive("Reports", "StockHealth") || IsActive("Reports", "Index") ? "active-page" : "")"
                           asp-controller="Reports"
                           asp-action="StockHealth">
                            <span>@SharedLocalizer["Nav_StockValuation"]</span>
                        </a>

                        @if (canViewSalesReport)
                        {
                            <a class="nav-link py-2 @(IsActive("Reports", "Sales") ? "active-page" : "")"
                               asp-controller="Reports"
                               asp-action="Sales">
                                <span>@SharedLocalizer["Nav_SalesReport"]</span>
                            </a>
                        }
                    </div>
                </li>

                <hr class="sidebar-divider" />
            }

            @if (canManageUsers)
            {
                <!-- ADMINISTRATION -->
                <div class="sidebar-heading">@navAdministration</div>

                <!-- User Management -->
                <li class="nav-item @(IsActive("Users") ? "active-page" : "")">
                    <a class="nav-link @(IsActive("Users") ? "active-page" : "")"
                       asp-controller="Users"
                       asp-action="Index">
                        <i class="fas fa-fw fa-users-cog"></i>
                        <span>@SharedLocalizer["Nav_UserManagement"]</span>
                    </a>
                </li>

                <hr class="sidebar-divider" />
            }

            <!-- Sidebar Toggler (Desktop - directly beneath navigation tabs) -->
            <div class="text-center d-none d-md-inline sidebar-toggler-wrapper my-2">
                <button class="rounded-circle border-0"
                        id="sidebarToggle"
                        type="button"
                        title="Toggle Sidebar"
                        aria-label="Toggle Sidebar">
                </button>
            </div>

            <!-- Theme Switcher (Separate at the very bottom corner of the sidebar) -->
            <div class="sidebar-bottom-corner mt-auto w-100 pb-3">
                <div class="sidebar-theme-item">
                    <button type="button"
                            id="themeToggleBtn"
                            class="sidebar-theme-toggle"
                            title="@Loc["Theme_Toggle"]"
                            aria-label="@Loc["Theme_Toggle"]"
                            data-light-text="@Loc["Theme_Light"]"
                            data-dark-text="@Loc["Theme_Dark"]">
                        <div class="theme-icon-container">
                            <i class="fas fa-moon theme-icon-moon"></i>
                            <i class="fas fa-sun theme-icon-sun"></i>
                        </div>
                        <div class="theme-info-box">
                            <span class="theme-title">@Loc["Theme"]</span>
                            <span class="theme-mode-label" id="themeStatusText">@Loc["Theme_Dark"]</span>
                        </div>
                        <div class="theme-switch-track">
                            <span class="theme-switch-thumb"></span>
                        </div>
                    </button>
                </div>
            </div>

        </ul>
        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Topbar -->
                <nav class="navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                    <button id="sidebarToggleTop"
                            class="btn btn-link d-md-none rounded-circle mr-3">
                        <i class="fa fa-bars"></i>
                    </button>

                    <!-- Global Search -->
                    <form class="d-none d-sm-inline-block form-inline mr-auto ml-md-3 my-2 my-md-0 mw-100 navbar-search position-relative">

                        <div class="input-group">

                            <input type="text"
                                   id="globalSearchInput"
                                   class="form-control bg-light border-0 small"
                                   placeholder="@Loc["SearchProductsCategories"]"
                                   aria-label="Search"
                                   autocomplete="off">

                            <div class="input-group-append">
                                <button class="btn btn-primary"
                                        type="button">
                                    <i class="fas fa-search fa-sm"></i>
                                </button>
                            </div>

                        </div>

                        <div id="searchResultsDropdown"
                             class="dropdown-menu shadow animated--grow-in w-100 mt-1"
                             style="display: none; position: absolute; top: 100%; left: 0; z-index: 1000;">
                        </div>

                    </form>

                    <!-- Topbar Navbar -->
                    <ul class="navbar-nav ml-auto">

                        <!-- ── Language Switcher ── -->
                        <li class="nav-item dropdown no-arrow mx-1 lang-switcher-dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               id="languageDropdown"
                               role="button"
                               data-toggle="dropdown"
                               aria-haspopup="true"
                               aria-expanded="false"
                               title="@SharedLocalizer["Lbl_SelectLanguage"]"
