    <!-- Theme Switcher Script (Loaded immediately before CDN scripts to ensure immediate responsiveness) -->
    <script>
            (function () {
                function applyTheme(theme, saveToStorage) {
                    if (theme !== 'light' && theme !== 'dark') theme = 'dark';

                    // 1. Update DOM attribute
                    document.documentElement.setAttribute('data-theme', theme);

                    // 2. Persist to storage only when explicitly requested (e.g., user toggle click)
                    // Passing saveToStorage=false prevents infinite ping-pong storage loops across browser tabs!
                    if (saveToStorage) {
                        try {
                            localStorage.setItem('ims_theme', theme);
                            document.cookie = 'ims_theme=' + theme + ';path=/;max-age=31536000;SameSite=Lax';
                        } catch (err) { }
                    }

                    // 3. Update Toggle Button UI if present
                    var btn = document.getElementById('themeToggleBtn');
                    var statusText = document.getElementById('themeStatusText');
                    if (btn) {
                        var lightLabel = btn.getAttribute('data-light-text') || 'Light Mode';
                        var darkLabel = btn.getAttribute('data-dark-text') || 'Dark Mode';
                        if (statusText) {
                            statusText.textContent = (theme === 'light') ? lightLabel : darkLabel;
                        }
                        btn.setAttribute('data-current-theme', theme);
                    }
                }

                function getSavedTheme() {
                    try {
                        var t = localStorage.getItem('ims_theme');
                        if (t === 'light' || t === 'dark') return t;
                    } catch (e) { }
                    var domTheme = document.documentElement.getAttribute('data-theme');
                    return (domTheme === 'light' || domTheme === 'dark') ? domTheme : 'dark';
                }

                function initThemeSwitcher() {
                    var currentTheme = getSavedTheme();
                    applyTheme(currentTheme, false);

                    var btn = document.getElementById('themeToggleBtn');
                    if (btn && !btn.dataset.wired) {
                        btn.dataset.wired = 'true';
                        btn.addEventListener('click', function (e) {
                            e.preventDefault();
                            var active = document.documentElement.getAttribute('data-theme') || 'dark';
                            var next = (active === 'light') ? 'dark' : 'light';
                            applyTheme(next, true);
                        });
                    }
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initThemeSwitcher);
                } else {
                    initThemeSwitcher();
                }

                // Sync theme when restored from browser cache (BFCache / back-forward navigation)
                window.addEventListener('pageshow', function () {
                    var currentTheme = getSavedTheme();
                    applyTheme(currentTheme, false);
                });

                // Sync across all browser tabs in real-time WITHOUT triggering echo loops
                window.addEventListener('storage', function (e) {
                    if (e.key === 'ims_theme') {
                        var newTheme = e.newValue;
                        if (newTheme === 'light' || newTheme === 'dark') {
                            if (document.documentElement.getAttribute('data-theme') !== newTheme) {
                                applyTheme(newTheme, false);
                            }
                        }
                    }
                });

                // Sync when user switches back to this browser tab ONLY if another tab changed the theme
                document.addEventListener('visibilitychange', function () {
                    if (document.visibilityState === 'visible') {
                        try {
                            var saved = localStorage.getItem('ims_theme');
                            if ((saved === 'light' || saved === 'dark') && document.documentElement.getAttribute('data-theme') !== saved) {
                                applyTheme(saved, false);
                            }
                        } catch (e) { }
                    }
                });
            })();
    </script>

